<Window x:Class="SmoothFrame.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmoothFrame Setup"
        Height="508" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource DefaultFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"
                      CornerRadius="14"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Master Action Button (Laser Precision Monolith) -->
        <Style x:Key="LaserActionButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrushAccentGradient}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontFamily" Value="{StaticResource DefaultFont}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="24,9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#A78BFA"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#7C3AED" BlurRadius="18" ShadowDepth="0" Opacity="0.45"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushAccentGradientHover}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#C4B5FD"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.02" ScaleY="1.02"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Ghost/Monolith Button -->
        <Style x:Key="MonolithGhostButton" TargetType="Button">
            <Setter Property="Background" Value="#0E1018"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
            <Setter Property="FontFamily" Value="{StaticResource DefaultFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#161826"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushBorderStrong}"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0A0B12"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Control Button: Minimize -->
        <Style x:Key="MonolithTitleButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#171826"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Control Button: Close (with laser crimson hover) -->
        <Style x:Key="MonolithCloseButton" TargetType="Button" BasedOn="{StaticResource MonolithTitleButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E11D48"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern iOS/Linear Toggle Switch Style for CheckBox -->
        <Style x:Key="LinearToggleSwitch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Label and Subtext -->
                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0" RecognizesAccessKey="True"/>

                            <!-- Pill Switch Track -->
                            <Border x:Name="Track" Grid.Column="1" Width="36" Height="20" CornerRadius="10"
                                    Background="#141624" BorderBrush="{StaticResource BrushBorderStrong}" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <!-- Thumb Circle -->
                                <Border x:Name="Thumb" Width="14" Height="14" CornerRadius="7" Background="#64748B"
                                        HorizontalAlignment="Left" Margin="2,0,0,0" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource BrushAccent}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#A78BFA"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                                <Setter TargetName="Thumb" Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#8B5CF6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Monolith Input Path TextBox -->
        <Style x:Key="MonolithPathBox" TargetType="TextBox">
            <Setter Property="Background" Value="#05060A"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                <Setter TargetName="Bd" Property="Background" Value="#090A12"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushBorderStrong}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Titanium Monolith Container -->
    <Border Background="{StaticResource BrushBgDark}"
            BorderBrush="{StaticResource BrushLaserBorder}"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="8" Opacity="0.8"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- = Title Bar Header = -->
            <Grid Grid.Row="0" Margin="16,0,10,0" Background="Transparent" MouseLeftButtonDown="OnTitleBarMouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Live indicator dot -->
                    <Border Background="#10B981" Width="6" Height="6" CornerRadius="3" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect Color="#10B981" BlurRadius="6" ShadowDepth="0" Opacity="0.8"/>
                        </Border.Effect>
                    </Border>
                    <TextBlock x:Name="HeaderTitleText" Text="SMOOTH_FRAME // DEPLOYER_V2.1"
                               FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                    <Border Background="#0E1018" BorderBrush="#1F2236" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="WIN_X64" FontFamily="{StaticResource MonoFont}" FontSize="9.5" Foreground="{StaticResource BrushTextMuted}"/>
                    </Border>
                </StackPanel>

                <!-- Window Chrome Control Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource MonolithTitleButton}" Click="OnMinimizeClick" ToolTip="Свернуть">
                        <Path Data="{StaticResource Icon.Min}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="10" Height="2" Stretch="Uniform"/>
                    </Button>
                    <Button Style="{StaticResource MonolithCloseButton}" Click="OnCloseClick" ToolTip="Закрыть">
                        <Path Data="{StaticResource Icon.Close}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="10" Height="10" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- = Main Content Area (600 - 38*2 = 524px inner width for maxBarWidth) = -->
            <Grid Grid.Row="1" Margin="38,2,38,18">

                <!-- = STEP 1: CONFIGURATION VIEW (BENTO TILES) = -->
                <Grid x:Name="ConfigView" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Bento Hero Section: Monolithic Product Identity -->
                    <Border Grid.Row="0" Background="{StaticResource BrushSurfaceCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Monolith Glyph -->
                            <Border Grid.Column="0" Background="#110F20" BorderBrush="{StaticResource BrushAccent}" BorderThickness="1" CornerRadius="10" Width="44" Height="44" Margin="0,0,14,0" VerticalAlignment="Center">
                                <Border.Effect>
                                    <DropShadowEffect Color="#8B5CF6" BlurRadius="12" ShadowDepth="0" Opacity="0.5"/>
                                </Border.Effect>
                                <Path Data="{StaticResource Icon.BoltFill}" Fill="{StaticResource BrushAccent}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Identity & Info -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="BannerTitle" Text="SMOOTH_FRAME" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                    <Border Background="#16122C" BorderBrush="#4C1D95" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="v2.2.0 // PRODUCTION" FontFamily="{StaticResource MonoFont}" Foreground="#C4B5FD" FontSize="9.5" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="BannerSubtitle" Text="Умный оптимизатор игровых задержек, таймеров и процессов"
                                           FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Telemetry Micro-Pill -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <Border Background="#090A12" BorderBrush="#1E2034" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,0,4">
                                    <TextBlock Text="0.50 ms NT_TIMER" FontFamily="{StaticResource MonoFont}" Foreground="#A78BFA" FontSize="9.5" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="#090A12" BorderBrush="#1E2034" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="ZERO_STALL // UDP" FontFamily="{StaticResource MonoFont}" Foreground="#10B981" FontSize="9.5" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Main Installation Bento Panels -->
                    <StackPanel x:Name="InstallPanel" Grid.Row="1" VerticalAlignment="Center">

                        <!-- Bento Tile 1: Target Directory -->
                        <Border Background="{StaticResource BrushSurfaceCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource Icon.Folder}" Fill="{StaticResource BrushAccent}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="ПАПКА УСТАНОВКИ" FontFamily="{StaticResource MonoFont}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}"/>
                                    </StackPanel>
                                    <TextBlock Text="180 MB REQUIRED" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="InstallPathBox" Style="{StaticResource MonolithPathBox}"/>
                                    <Button Grid.Column="1" Style="{StaticResource MonolithGhostButton}" Content="ОБЗОР" Margin="6,0,0,0" Padding="14,6" Click="OnBrowseClick"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Bento Tile 2: Integration Toggles (Linear-Style Switches) -->
                        <Border Background="{StaticResource BrushSurfaceCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="ПАРАМЕТРЫ ИНТЕГРАЦИИ" FontFamily="{StaticResource MonoFont}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,8"/>

                                <!-- Toggle 1: Desktop Shortcut -->
                                <CheckBox x:Name="DesktopShortcutCheck" Style="{StaticResource LinearToggleSwitch}" IsChecked="True" Margin="0,3">
                                    <StackPanel>
                                        <TextBlock Text="Ярлык на Рабочем столе" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource BrushTextPrimary}"/>
                                        <TextBlock Text="Быстрый запуск профилей оптимизации" FontSize="11" Foreground="{StaticResource BrushTextMuted}"/>
                                    </StackPanel>
                                </CheckBox>

                                <Border Height="1" Background="#121422" Margin="0,6"/>

                                <!-- Toggle 2: Start Menu -->
                                <CheckBox x:Name="StartMenuShortcutCheck" Style="{StaticResource LinearToggleSwitch}" IsChecked="True" Margin="0,3">
                                    <StackPanel>
                                        <TextBlock Text="Ярлык в меню «Пуск»" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource BrushTextPrimary}"/>
                                        <TextBlock Text="Регистрация в системном каталоге Windows" FontSize="11" Foreground="{StaticResource BrushTextMuted}"/>
                                    </StackPanel>
                                </CheckBox>

                                <Border Height="1" Background="#121422" Margin="0,6"/>

                                <!-- Toggle 3: Auto Launch -->
                                <CheckBox x:Name="LaunchAfterCheck" Style="{StaticResource LinearToggleSwitch}" IsChecked="True" Margin="0,3">
                                    <StackPanel>
                                        <TextBlock Text="Запустить SmoothFrame сразу после завершения" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource BrushTextPrimary}"/>
                                        <TextBlock Text="Мгновенный запуск системной службы таймера" FontSize="11" Foreground="{StaticResource BrushTextMuted}"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Uninstall Confirmation Panel (Monolith Warning) -->
                    <StackPanel x:Name="UninstallPanel" Grid.Row="1" VerticalAlignment="Center" Visibility="Collapsed">
                        <Border Background="#16080E" BorderBrush="#501826" BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Path Data="{StaticResource Icon.Shield}" Fill="#FB7185" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="ПОЛНОЕ УДАЛЕНИЕ СИСТЕМЫ" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="Bold" Foreground="#FDA4AF" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Все системные параметры (схема питания, высокоточный таймер Windows) гарантированно возвращаются в исходное состояние. Ярлыки, файлы программы и автозагрузка очищаются без следов."
                                           FontSize="12" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" LineHeight="18"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Bottom Action Bar -->
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource Icon.Shield}" Fill="#10B981" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="CLEAN_DEPLOY // 100% REVERSIBLE" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource BrushTextMuted}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource MonolithGhostButton}" Content="ОТМЕНА" Click="OnCancelClick" Margin="0,0,8,0"/>
                            <Button x:Name="PrimaryActionButton" Style="{StaticResource LaserActionButton}" Content="УСТАНОВИТЬ" Click="OnPrimaryActionClick"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- = STEP 2: PROGRESS VIEW (HIGH-TECH TERMINAL LOADER) = -->
                <Grid x:Name="ProgressView" Visibility="Collapsed" VerticalAlignment="Center">
                    <Border Background="{StaticResource BrushSurfaceCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="12" Padding="24,24">
                        <StackPanel>
                            <!-- Terminal Header -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
                                <Path Data="{StaticResource Icon.Terminal}" Stroke="{StaticResource BrushAccent}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="DEPLOYING_COMPONENTS" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock x:Name="ProgressTitle" Text="Выполняется установка SmoothFrame..." FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock x:Name="ProgressStatusText" Text="Подготовка файлов..." FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                            <!-- Laser Progress Bar (Exact 524px track) -->
                            <Border Height="8" Background="#06070C" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,8" SnapsToDevicePixels="True">
                                <Border x:Name="ProgressBarFill" Background="{StaticResource BrushAccentGradient}" CornerRadius="3" HorizontalAlignment="Left" Width="0"/>
                            </Border>

                            <Grid>
                                <TextBlock Text="STATUS: EXTRACTING_PAYLOAD" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="ProgressPercentText" Text="0%" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushAccentHover}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- = STEP 3: COMPLETED VIEW (MONOLITH SUCCESS) = -->
                <Grid x:Name="CompletedView" Visibility="Collapsed" VerticalAlignment="Center">
                    <Border Background="{StaticResource BrushSurfaceCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="12" Padding="24,24">
                        <StackPanel HorizontalAlignment="Center">
                            <!-- Geometric Success Glyph -->
                            <Border Background="#092018" BorderBrush="#10B981" BorderThickness="1" CornerRadius="14" Width="48" Height="48" HorizontalAlignment="Center" Margin="0,0,0,14">
                                <Border.Effect>
                                    <DropShadowEffect Color="#10B981" BlurRadius="16" ShadowDepth="0" Opacity="0.6"/>
                                </Border.Effect>
                                <Path Data="{StaticResource Icon.Check}" Stroke="#10B981" StrokeThickness="2.5" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock x:Name="CompletedTitleText" Text="Установка успешно завершена!" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="CompletedSubText" Text="SmoothFrame готов к использованию и оптимизации ваших игр." FontSize="12" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,18"/>

                            <!-- Monolith Specs Grid -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                                <Border Background="#080912" BorderBrush="#1C1E30" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,6,0">
                                    <TextBlock Text="NT_TIMER: 0.50 ms" FontFamily="{StaticResource MonoFont}" Foreground="#CBD5E1" FontSize="10.5" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="#080912" BorderBrush="#1C1E30" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,6,0">
                                    <TextBlock Text="UDP_HUD: 127.0.0.1" FontFamily="{StaticResource MonoFont}" Foreground="#CBD5E1" FontSize="10.5" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="#080912" BorderBrush="#1C1E30" BorderThickness="1" CornerRadius="6" Padding="10,6">
                                    <TextBlock Text="SAFETY: 100% REVERSIBLE" FontFamily="{StaticResource MonoFont}" Foreground="#10B981" FontSize="10.5" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>

                            <Button Style="{StaticResource LaserActionButton}" Content="ЗАВЕРШИТЬ" Padding="32,9" HorizontalAlignment="Center" Click="OnFinishClick"/>
                        </StackPanel>
                    </Border>
                </Grid>

            </Grid>
        </Grid>
    </Border>
</Window>
