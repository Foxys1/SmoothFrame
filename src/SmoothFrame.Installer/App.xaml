<Application x:Class="SmoothFrame.Installer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="OnStartup">
    <Application.Resources>
        <!-- Modern Dark Palette matching SmoothFrame -->
        <Color x:Key="ColorBgDark">#0C0E14</Color>
        <Color x:Key="ColorSurface">#131620</Color>
        <Color x:Key="ColorSurfaceCard">#181B26</Color>
        <Color x:Key="ColorSurfaceHover">#212534</Color>
        <Color x:Key="ColorBorder">#252A3D</Color>
        <Color x:Key="ColorAccent">#6366F1</Color>
        <Color x:Key="ColorAccentHover">#797CF8</Color>
        <Color x:Key="ColorTextPrimary">#F1F5F9</Color>
        <Color x:Key="ColorTextSecondary">#94A3B8</Color>
        <Color x:Key="ColorTextMuted">#64748B</Color>

        <SolidColorBrush x:Key="BrushBgDark" Color="{StaticResource ColorBgDark}"/>
        <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}"/>
        <SolidColorBrush x:Key="BrushSurfaceCard" Color="{StaticResource ColorSurfaceCard}"/>
        <SolidColorBrush x:Key="BrushSurfaceHover" Color="{StaticResource ColorSurfaceHover}"/>
        <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}"/>
        <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}"/>
        <SolidColorBrush x:Key="BrushAccentHover" Color="{StaticResource ColorAccentHover}"/>
        <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}"/>
        <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}"/>
        <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}"/>

        <FontFamily x:Key="DefaultFont">Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif</FontFamily>

        <!-- Vectors -->
        <Geometry x:Key="Icon.BoltFill">M13.1 2.1 4.5 13.5h6.1l-1.1 8.4 8.7-11.4h-6.1z</Geometry>
        <Geometry x:Key="Icon.Check">M5.4 12.6l4.3 4.3L18.6 8</Geometry>
        <Geometry x:Key="Icon.Close">M6.4 6.4l11.2 11.2M17.6 6.4 6.4 17.6</Geometry>
        <Geometry x:Key="Icon.Min">M6.4 12h11.2</Geometry>
        <Geometry x:Key="Icon.Folder">M3.6 6.4C3.6 5.5 4.3 4.8 5.2 4.8h4.2c.4 0 .8.2 1.1.5l1.4 1.4c.3.3.7.5 1.1.5h5.8c.9 0 1.6.7 1.6 1.6v8.4c0 .9-.7 1.6-1.6 1.6H5.2c-.9 0-1.6-.7-1.6-1.6V6.4z</Geometry>
    </Application.Resources>
</Application>
