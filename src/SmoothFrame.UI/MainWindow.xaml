                                                </Grid.ColumnDefinitions>
                                                <controls:AppIcon Grid.Column="0" Data="{StaticResource Icon.Check}" Size="12" Foreground="#FBBF24" VerticalAlignment="Center" Margin="0,1,10,0"/>
                                                <TextBlock Grid.Column="1" Text="{DynamicResource Prot.Crash.P3}" Style="{StaticResource TextBody}" FontSize="12.5" LineHeight="18" TextWrapping="Wrap"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Anti-Cheat Trust Bar -->
                                <Border Style="{StaticResource Card}" CornerRadius="14" Padding="18,16">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Prot.Chips.Title}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,12"/>
                                        <WrapPanel Orientation="Horizontal">
                                            <Border Background="{StaticResource BrushBgInset}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,8,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="6" Height="6" Fill="#22C55E" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Valve Anti-Cheat (CS2)" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{StaticResource BrushBgInset}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,8,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="6" Height="6" Fill="#22C55E" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Riot Vanguard (Valorant)" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{StaticResource BrushBgInset}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,8,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="6" Height="6" Fill="#22C55E" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Easy Anti-Cheat (Rust, Apex)" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{StaticResource BrushBgInset}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,8,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="6" Height="6" Fill="#22C55E" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="BattlEye (R6 Siege, DayZ)" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{StaticResource BrushBgInset}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,8,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="6" Height="6" Fill="#22C55E" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="FACEIT Anti-Cheat" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{StaticResource BrushBgInset}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,8,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="6" Height="6" Fill="#22C55E" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Ricochet (Call of Duty)" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ===================== FOOTER ===================== -->
            <Border x:Name="FooterBorder" Grid.Row="2" Background="{StaticResource BrushBgSide}"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,15,15" Padding="20,0">
                <Grid VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Footer.Left}" Style="{StaticResource TextCaption}"/>
                    <TextBlock Text="{DynamicResource Footer.Right}" Style="{StaticResource TextCaption}" HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <!-- ===================== ONBOARDING OVERLAY (GAME-READY SHOWCASE) ===================== -->
            <Grid Grid.Row="1" x:Name="OnboardingOverlay" Visibility="Collapsed"
                  Background="{StaticResource BrushBgApp}">

                <!-- Ambient Cinematic Radial Glow -->
                <Ellipse x:Name="OnbAmbientGlow" Width="720" Height="500" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Color="#251648" Offset="0"/>
                            <GradientStop Color="#100C22" Offset="0.55"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- Subtle Cyber Blueprint / Corner Target Brackets (HUD Styling) -->
                <Canvas x:Name="OnbHudBrackets" IsHitTestVisible="False" Opacity="0.3">
                    <Path Data="M 40,70 L 40,40 L 70,40" Stroke="{StaticResource BrushAccent}" StrokeThickness="1.5"/>
                    <Path Data="M 1140,70 L 1140,40 L 1110,40" Stroke="{StaticResource BrushAccent}" StrokeThickness="1.5"/>
                    <Path Data="M 40,640 L 40,670 L 70,670" Stroke="{StaticResource BrushAccent}" StrokeThickness="1.5"/>
                    <Path Data="M 1140,640 L 1140,670 L 1110,670" Stroke="{StaticResource BrushAccent}" StrokeThickness="1.5"/>
                </Canvas>

                <!-- Main Showcase Hub Content -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="720">

                    <!-- Engine Status Pill Tag -->
                    <Border x:Name="OnbStatusPill" Background="#120F24" BorderBrush="#35265E" BorderThickness="1" CornerRadius="16"
                            Padding="14,4" HorizontalAlignment="Center" Margin="0,0,0,22"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="OnbStatusPillTranslate" Y="0"/>
                        </Border.RenderTransform>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="6" Height="6" CornerRadius="3" Background="#10B981" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Border.Effect>
                                    <DropShadowEffect Color="#10B981" BlurRadius="6" ShadowDepth="0" Opacity="0.9"/>
                                </Border.Effect>
                            </Border>
                            <TextBlock Text="GAME OPTIMIZATION ENGINE // INITIAL SETUP"
                                       Foreground="#C4B5FD" FontSize="11" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Hero Brand Monolith with Concentric Glow Rings -->
                    <Grid x:Name="OnbHeroIcon" HorizontalAlignment="Center" Margin="0,0,0,18"
                          RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="OnbHeroScale" ScaleX="1" ScaleY="1"/>
                                <TranslateTransform x:Name="OnbHeroTranslate" Y="0"/>
                            </TransformGroup>
                        </Grid.RenderTransform>

                        <!-- Outer Ambient Pulse Ring -->
                        <Border Width="106" Height="106" CornerRadius="34"
                                Background="Transparent" BorderBrush="{StaticResource BrushAccent}" BorderThickness="1"
                                Opacity="0.25" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <!-- Middle Ring -->
                        <Border Width="92" Height="92" CornerRadius="28"
                                Background="#140E2A" BorderBrush="#5B21B6" BorderThickness="1.5"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="#8B5CF6" BlurRadius="28" ShadowDepth="0" Opacity="0.4"/>
                            </Border.Effect>
                        </Border>

                        <!-- Core Glowing Squircle -->
                        <Border Background="{StaticResource BrushAccentGradient}" CornerRadius="22" Width="76" Height="76"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="#8B5CF6" BlurRadius="24" ShadowDepth="0" Opacity="0.7"/>
                            </Border.Effect>
                            <Path Data="{StaticResource Icon.BoltFill}" Fill="#FFFFFF" Stretch="Uniform"
                                  Width="26" Height="38"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <!-- Dynamic Multilingual Heading -->
                    <StackPanel x:Name="OnbHeadingGroup" HorizontalAlignment="Center"
                                RenderTransformOrigin="0.5,0.5">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="OnbHeadingTranslate" Y="0"/>
                        </StackPanel.RenderTransform>

                        <TextBlock x:Name="WelcomeText" FontSize="40" FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   HorizontalAlignment="Center" Margin="0,0,0,6" TextAlignment="Center"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="WelcomeTextTranslate" Y="0"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>

                        <!-- Active Locale Badge -->
                        <Border x:Name="WelcomeLanguageBadge" Background="#121024" BorderBrush="#3B2A6B" BorderThickness="1" CornerRadius="6"
                                Padding="12,3" HorizontalAlignment="Center" Margin="0,0,0,10"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="WelcomeLanguageTranslate" Y="0"/>
                            </Border.RenderTransform>
                            <TextBlock x:Name="WelcomeLanguage" Foreground="#A78BFA" FontSize="11.5" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                        </Border>

                        <TextBlock x:Name="OnbTagline" Text="{DynamicResource Onb.Tagline}" FontSize="14" FontWeight="Normal"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   HorizontalAlignment="Center" Margin="0,2,0,0" TextAlignment="Center"/>
                    </StackPanel>

                    <!-- Compact Language Selector Capsule -->
                    <Border x:Name="OnbLangCapsule" Background="#0C0D17" BorderBrush="{StaticResource BrushBorderStrong}" BorderThickness="1"
                            CornerRadius="10" Padding="10,6" HorizontalAlignment="Center" Margin="0,20,0,22"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="OnbLangTranslate" Y="0"/>
                        </Border.RenderTransform>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#1A1535" CornerRadius="6" Width="26" Height="26" Margin="0,0,9,0" VerticalAlignment="Center">
                                <controls:AppIcon Data="{StaticResource Icon.Globe}" Size="13"
                                                  Foreground="{StaticResource BrushAccent}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{DynamicResource Onb.Language}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <ComboBox x:Name="OnboardingLanguageCombo" Style="{StaticResource DarkComboBox}"
                                      Width="115" DisplayMemberPath="NativeName"
                                      VerticalAlignment="Center"
                                      SelectionChanged="OnboardingLanguage_SelectionChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- Master Action CTA Button -->
                    <Button x:Name="OnbContinueBtn" Style="{StaticResource PrimaryButton}" Padding="46,13"
                            HorizontalAlignment="Center" Click="OnOnboardingContinue"
                            RenderTransformOrigin="0.5,0.5">
                        <Button.RenderTransform>
                            <TranslateTransform x:Name="OnbContinueTranslate" Y="0"/>
                        </Button.RenderTransform>
                        <Button.Effect>
                            <DropShadowEffect Color="#8B5CF6" BlurRadius="24" ShadowDepth="2" Opacity="0.6"/>
                        </Button.Effect>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Onb.Continue}" FontSize="14.5" FontWeight="Bold" Margin="0,0,10,0"/>
                            <controls:AppIcon Data="{StaticResource Icon.ArrowRight}" Size="15"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Grid>

            <!-- ===================== CLOSE CONFIRMATION MODAL OVERLAY ===================== -->
            <Grid Grid.Row="0" Grid.RowSpan="3" x:Name="CloseConfirmationOverlay" Visibility="Collapsed"
                  Background="#D608080C" Panel.ZIndex="1000" Opacity="0"
                  MouseDown="CloseConfirmationOverlay_MouseDown">

                <!-- Ambient Glow behind modal card -->
                <Ellipse Width="560" Height="380" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Color="#2A184D" Offset="0"/>
                            <GradientStop Color="#120D22" Offset="0.55"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- Modal Dialog Card Container -->
                <Grid Width="490" HorizontalAlignment="Center" VerticalAlignment="Center"
                      RenderTransformOrigin="0.5,0.5" UseLayoutRounding="True" SnapsToDevicePixels="True">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="CloseModalScale" ScaleX="1" ScaleY="1"/>
                    </Grid.RenderTransform>

                    <!-- Pure Shadow Layer (isolated from text to prevent rasterization blur) -->
                    <Border Background="#12101C" CornerRadius="16">
                        <Border.Effect>
                            <DropShadowEffect Color="#8B5CF6" BlurRadius="36" ShadowDepth="4" Opacity="0.35"/>
                        </Border.Effect>
                    </Border>

                    <!-- Pure Content Surface (no effects, crisp native ClearType text) -->
                    <Border Background="#12101C" BorderBrush="#35265E" BorderThickness="1.5" CornerRadius="16"
                            Padding="26,24" MouseDown="CloseModalCard_MouseDown"
                            UseLayoutRounding="True" SnapsToDevicePixels="True"
                            TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
                            RenderOptions.ClearTypeHint="Enabled">

                        <StackPanel>
                            <!-- Top Tag & Brand Header -->
                            <Grid Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{StaticResource BrushAccentGradient}" CornerRadius="6" Width="22" Height="22" Margin="0,0,8,0">
                                        <Path Data="{StaticResource Icon.BoltFill}" Fill="#FFFFFF" Stretch="Uniform" Width="8" Height="11"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="SMOOTHFRAME // WINDOW ACTION" Foreground="#A78BFA" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Close / Dismiss (X) in corner -->
                                <Button Style="{StaticResource TitleBarButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Width="26" Height="26" Padding="0" Click="CloseDialogCancel_Click" ToolTip="{DynamicResource Dialog.Close.Cancel}">
                                    <controls:AppIcon Data="{StaticResource Icon.Close}" Size="11" Foreground="{StaticResource BrushTextMuted}"/>
                                </Button>
                            </Grid>

                            <!-- Dialog Title & Description -->
                            <TextBlock Text="{DynamicResource Dialog.Close.Title}" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                            <TextBlock Text="{DynamicResource Dialog.Close.Desc}" Style="{StaticResource TextBody}" FontSize="12.5" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap" Margin="0,0,0,18"/>

                            <!-- Choice 1: Minimize to System Tray -->
                            <Button Style="{StaticResource CloseDialogTrayButton}" Click="CloseDialogTray_Click" Margin="0,0,0,10">
                                <Grid Margin="14,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10"
                                            Background="{StaticResource BrushAccentSoft}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                            Margin="0,0,14,0" VerticalAlignment="Center">
                                        <controls:AppIcon Data="{StaticResource Icon.RestoreWindow}" Size="17"
                                                          Foreground="{StaticResource BrushAccentHover}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Dialog.Close.Tray}" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                        <TextBlock Text="{DynamicResource Dialog.Close.TrayDesc}" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- Choice 2: Exit Completely -->
                            <Button Style="{StaticResource CloseDialogExitButton}" Click="CloseDialogExit_Click" Margin="0,0,0,18">
                                <Grid Margin="14,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10"
                                            Background="#28131B" BorderBrush="#501822" BorderThickness="1"
                                            Margin="0,0,14,0" VerticalAlignment="Center">
                                        <controls:AppIcon Data="{StaticResource Icon.Power}" Size="17"
                                                          Foreground="#EF4444"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Dialog.Close.Exit}" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                        <TextBlock Text="{DynamicResource Dialog.Close.ExitDesc}" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- Bottom Footer: Remember Choice Toggle & Cancel Button -->
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox x:Name="CloseRememberCheckBox" Style="{StaticResource SwitchStyle}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="{DynamicResource Dialog.Close.Remember}" VerticalAlignment="Center"
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="12" Cursor="Hand"
                                               MouseDown="CloseRememberLabel_MouseDown"/>
                                </StackPanel>

                                <Button Content="{DynamicResource Dialog.Close.Cancel}" Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Right" Padding="18,6" FontSize="12" Click="CloseDialogCancel_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
