<Window x:Class="SmoothFrame.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:SmoothFrame.UI.Controls"
        xmlns:converters="clr-namespace:SmoothFrame.UI.Converters"
        mc:Ignorable="d"
        Title="{DynamicResource App.Title}"
        Width="1260" Height="860"
        MinWidth="1040" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="16" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <converters:Base64ToImageConverter x:Key="Base64ToImageConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisConverter" />

        <Style x:Key="EmptyHint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="8,20,8,18" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasItems, ElementName=GamesList}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PageHeaderTitle" TargetType="TextBlock" BasedOn="{StaticResource TextTitle}">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="SmallMetricCard" TargetType="Border" BasedOn="{StaticResource CardInset}">
            <Setter Property="Padding" Value="15,13" />
        </Style>
        <Style x:Key="DiagnosticCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,10,10" />
        </Style>
        <Style x:Key="SettingRow" TargetType="Border" BasedOn="{StaticResource CardInset}">
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder"
            Background="{DynamicResource BrushBgApp}"
            BorderBrush="{DynamicResource BrushBorderStrong}"
            BorderThickness="1" CornerRadius="16"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Window chrome / identity -->
            <Border x:Name="TitleBarBorder" Grid.Row="0"
                    Background="{DynamicResource BrushBgSide}"
                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1"
                    CornerRadius="15,15,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource BrushAccentGradient}">
                            <Path Data="{StaticResource Icon.BoltFill}" Fill="{DynamicResource BrushOnAccent}" Width="12" Height="17"
                                  Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="SmoothFrame" FontSize="14" FontWeight="SemiBold"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                        <Border Background="{DynamicResource BrushAccentSoft}" BorderBrush="{DynamicResource BrushBorderGlow}" BorderThickness="1"
                                CornerRadius="5" Padding="6,2" Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="PRO" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource BrushVioletText}" />
                        </Border>
                        <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="5" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Badge.Safe}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                        </Border>
                    </StackPanel>

                    <Border Grid.Column="1" Background="{DynamicResource BrushBgInset}" BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="18,0,14,0"
                            VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="500">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource BrushTextMuted}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOptimizing}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource BrushSuccess}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{DynamicResource TitleBar.Standby}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOptimizing}" Value="True">
                                                <Setter Property="Text" Value="{DynamicResource TitleBar.Active}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,8,0"
                                VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource TitleBarButton}" Click="MinimizeButton_Click" ToolTip="Minimize">
                            <controls:AppIcon Data="{StaticResource Icon.Min}" Size="12" />
                        </Button>
                        <Button x:Name="BtnMaximize" Style="{StaticResource TitleBarButton}" Click="MaximizeButton_Click" ToolTip="Maximize">
                            <controls:AppIcon x:Name="MaximizeIcon" Data="{StaticResource Icon.Max}" Size="12" />
                        </Button>
                        <Button Style="{StaticResource TitleBarCloseButton}" Click="CloseButton_Click" ToolTip="Close">
                            <controls:AppIcon Data="{StaticResource Icon.Close}" Size="12" Foreground="{DynamicResource BrushDanger}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main navigation and work area -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="226" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource BrushBgSide}"
                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="18,22,18,18">
                            <TextBlock Text="{DynamicResource Nav.Caption}" FontSize="10.5" FontWeight="Bold"
                                       Foreground="{DynamicResource BrushTextMuted}" Margin="4,0,0,10" />
                            <RadioButton x:Name="NavOpt" GroupName="Nav" Style="{StaticResource SideNavItem}" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <controls:AppIcon Data="{StaticResource Icon.Gauge}" Size="17" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource Nav.Opt}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavMinecraft" GroupName="Nav" Style="{StaticResource SideNavItem}" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <controls:AppIcon Data="{StaticResource Icon.Game}" Size="17" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource Nav.Minecraft}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavSettings" GroupName="Nav" Style="{StaticResource SideNavItem}" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <controls:AppIcon Data="{StaticResource Icon.Settings}" Size="17" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource Nav.Settings}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavProtect" GroupName="Nav" Style="{StaticResource SideNavItem}" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <controls:AppIcon Data="{StaticResource Icon.ShieldCheck}" Size="17" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource Nav.Protect}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="13,8,13,14">
                            <Border Style="{StaticResource CardInset}" Padding="11,9" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="{DynamicResource Set.Theme.Title}" FontSize="11.5" FontWeight="SemiBold" />
                                        <TextBlock FontSize="10" Foreground="{DynamicResource BrushTextMuted}" Margin="0,1,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Setter Property="Text" Value="{DynamicResource Theme.Light}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                            <Setter Property="Text" Value="{DynamicResource Theme.Dark}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource SwitchStyle}" IsChecked="{Binding IsDarkTheme, Mode=TwoWay}" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource CardInset}" Padding="12,11">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource BrushSuccess}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="SmoothFrame Engine" FontSize="11.5" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding SubStatusMessage, Mode=OneWay}" FontSize="10.5"
                                               Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid x:Name="ContentHost" Grid.Column="1" Background="{DynamicResource BrushBgApp}">
                    <!-- ==================== OPTIMIZATION ==================== -->
                    <Grid x:Name="PageOpt">
                        <controls:SmoothScrollViewer Style="{StaticResource DarkScrollViewer}">
                            <StackPanel Margin="26,24,26,30">
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Opt.Title}" Style="{StaticResource PageHeaderTitle}" />
                                        <TextBlock Text="{DynamicResource Opt.Subtitle}" Style="{StaticResource TextBody}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource CardInset}" Padding="10,7" VerticalAlignment="Center" Margin="14,0,0,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <controls:AppIcon Data="{StaticResource Icon.Bolt}" Size="13" Foreground="{DynamicResource BrushAccent}" Margin="0,0,7,0" />
                                            <TextBlock Text="{DynamicResource Header.HotkeyHint}" FontSize="10.5" Foreground="{DynamicResource BrushTextSecondary}" />
                                            <TextBlock Text="Ctrl + Shift + B" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushVioletText}" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Style="{StaticResource HeroCard}" Padding="22" Margin="0,0,0,18">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,18,0" VerticalAlignment="Center">
                                            <Border CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,10" BorderThickness="1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderGlow}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOptimizing}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource BrushDangerSoft}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource BrushDangerBorder}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{DynamicResource BrushAccentHover}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOptimizing}" Value="True">
                                                                        <Setter Property="Fill" Value="{DynamicResource BrushDanger}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock FontSize="10" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{DynamicResource Hero.StandbyBadge}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource BrushVioletText}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOptimizing}" Value="True">
                                                                        <Setter Property="Text" Value="{DynamicResource Hero.ActiveBadge}" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource BrushDanger}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                            <StackPanel x:Name="HeroTitleGroup" RenderTransformOrigin="0.5,0.5">
                                                <StackPanel.RenderTransform>
                                                    <TranslateTransform x:Name="HeroTitleTranslate" Y="0" />
                                                </StackPanel.RenderTransform>
                                                <TextBlock x:Name="HeroStatusTextBlock" Text="{Binding StatusMessage, Mode=OneWay}" FontSize="21" FontWeight="SemiBold"
                                                           TextWrapping="Wrap" Margin="0,0,0,5" />
                                                <TextBlock x:Name="HeroSubStatusTextBlock" Text="{Binding SubStatusMessage, Mode=OneWay}" Style="{StaticResource TextBody}" />
                                            </StackPanel>
                                            <TextBlock Text="{DynamicResource Hero.Protect}" FontSize="11" Foreground="{DynamicResource BrushVioletText}"
                                                       TextWrapping="Wrap" Margin="0,12,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Grid.Row="0" Command="{Binding ToggleOptimizationCommand}"
                                                Style="{StaticResource HeroActionButton}"
                                                MinWidth="174" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:AppIcon Data="{StaticResource Icon.Power}" Size="17" Foreground="{DynamicResource BrushOnAccent}" Margin="0,0,9,0" />
                                                <TextBlock Text="{Binding ActionButtonText, Mode=OneWay}" Foreground="{DynamicResource BrushOnAccent}" FontSize="13.5" FontWeight="Bold"
                                                           TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,18,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource SmallMetricCard}" Margin="0,0,7,0" ToolTip="{DynamicResource Card.Timer.Hint}">
                                                <StackPanel>
                                                    <TextBlock Text="{DynamicResource Card.Timer.Label}" Style="{StaticResource TextCaption}" />
                                                    <TextBlock Text="{Binding TimerText, Mode=OneWay}" Style="{StaticResource TextValue}" Margin="0,3,0,0" />
                                                    <TextBlock Text="{DynamicResource Card.Timer.Sub}" Style="{StaticResource TextCaption}" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="1" Style="{StaticResource SmallMetricCard}" Margin="3,0" ToolTip="{DynamicResource Card.Power.Hint}">
                                                <StackPanel>
                                                    <TextBlock Text="{DynamicResource Card.Power.Label}" Style="{StaticResource TextCaption}" />
                                                    <TextBlock Text="{Binding PowerPlanText, Mode=OneWay}" Style="{StaticResource TextValue}" Margin="0,3,0,0" />
                                                    <TextBlock Text="{DynamicResource Card.Power.Sub}" Style="{StaticResource TextCaption}" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" Style="{StaticResource SmallMetricCard}" Margin="3,0" ToolTip="{DynamicResource Card.Prio.Hint}">
                                                <StackPanel>
                                                    <TextBlock Text="{DynamicResource Card.Prio.Label}" Style="{StaticResource TextCaption}" />
                                                    <TextBlock Text="{Binding PriorityText, Mode=OneWay}" Style="{StaticResource TextValue}" Margin="0,3,0,0" />
                                                    <TextBlock Text="{DynamicResource Card.Prio.Sub}" Style="{StaticResource TextCaption}" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="3" Style="{StaticResource SmallMetricCard}" Margin="7,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="Windows" Style="{StaticResource TextCaption}" />
                                                    <TextBlock Text="{Binding WindowsVersionText, Mode=OneWay}" Style="{StaticResource TextValue}" Margin="0,3,0,0" />
                                                    <TextBlock Text="{DynamicResource Card.Prot.Label}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushVioletText}" Margin="0,2,0,0" />
                                                    <TextBlock Text="{DynamicResource Card.Prot.Sub}" Style="{StaticResource TextCaption}" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.25*" />
                                        <ColumnDefinition Width="0.9*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18" Margin="0,0,9,0">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{DynamicResource Lib.Title}" Style="{StaticResource TextSection}" />
                                                    <TextBlock Text="{DynamicResource Lib.Desc}" Style="{StaticResource TextCaption}" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshGamesCommand}" Margin="0,0,7,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <controls:AppIcon Data="{StaticResource Icon.Refresh}" Size="13" Margin="0,0,6,0" />
                                                            <TextBlock Text="{DynamicResource Btn.Refresh}" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddCustomGameCommand}" Padding="12,9">
                                                        <StackPanel Orientation="Horizontal">
                                                            <controls:AppIcon Data="{StaticResource Icon.Plus}" Size="13" Foreground="{DynamicResource BrushOnAccent}" Margin="0,0,6,0" />
                                                            <TextBlock Text="{DynamicResource Btn.AddGame}" Foreground="{DynamicResource BrushOnAccent}" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="{DynamicResource Lib.Empty}" Style="{StaticResource EmptyHint}" />
                                            <ListBox x:Name="GamesList" ItemsSource="{Binding Games}"
                                                     SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                                                     SelectionChanged="GamesList_SelectionChanged"
                                                     ItemContainerStyle="{StaticResource GameCardItem}"
                                                     Background="Transparent" BorderThickness="0"
                                                     HorizontalContentAlignment="Stretch">
                                                <ListBox.Template>
                                                    <ControlTemplate TargetType="ListBox">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}">
                                                            <ItemsPresenter />
                                                        </Border>
                                                    </ControlTemplate>
                                                </ListBox.Template>
                                                <ListBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel IsItemsHost="True" />
                                                    </ItemsPanelTemplate>
                                                </ListBox.ItemsPanel>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Width="212">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="42" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="38" Height="38" CornerRadius="9" Background="{DynamicResource BrushCardBg}"
                                                                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" VerticalAlignment="Center">
                                                                <Image Source="{Binding IconBase64, Converter={StaticResource Base64ToImageConverter}}"
                                                                       Width="24" Height="24" Stretch="Uniform" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,6,0">
                                                                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding ProcessName}" FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding Source}" FontSize="9.5" Foreground="{DynamicResource BrushTextMuted}" />
                                                            </StackPanel>
                                                            <Button Grid.Column="2" Width="28" Height="28" ToolTip="{DynamicResource VM.Msg.RemoveTitle}"
                                                                    Command="{Binding DataContext.RemoveCustomGameCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                                                    CommandParameter="{Binding}">
                                                                <Button.Style>
                                                                    <Style TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
                                                                        <Setter Property="IsEnabled" Value="False" />
                                                                        <Setter Property="Opacity" Value="0" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Source}" Value="Custom">
                                                                                <Setter Property="IsEnabled" Value="True" />
                                                                                <Setter Property="Opacity" Value="1" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                                <controls:AppIcon Data="{StaticResource Icon.Trash}" Size="13" Foreground="{DynamicResource BrushDanger}" />
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18" Margin="9,0,0,0">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{DynamicResource Deck.QuickTitle}" Style="{StaticResource TextSection}" />
                                                <Border Grid.Column="1" Background="{DynamicResource BrushAccentSoft}" CornerRadius="5" Padding="7,3">
                                                    <TextBlock Text="{DynamicResource Deck.QuickBadge}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource BrushVioletText}" />
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{DynamicResource Deck.QuickDesc}" Style="{StaticResource TextCaption}" Margin="0,3,0,12" />
                                            <Border Style="{StaticResource SettingRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,10,0">
                                                        <TextBlock Text="{DynamicResource Deck.AutoBoost.Title}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <TextBlock Text="{DynamicResource Deck.AutoBoost.Desc}" Style="{StaticResource TextCaption}" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="1" Style="{StaticResource SwitchStyle}" IsChecked="{Binding AutoBoostOnGameLaunch, Mode=TwoWay}" />
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource SettingRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,10,0">
                                                        <TextBlock Text="{DynamicResource Deck.Bg.Title}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
