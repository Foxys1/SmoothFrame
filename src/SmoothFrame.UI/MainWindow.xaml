                    MinHeight="34" Padding="17,5">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}"
                               TextWrapping="Wrap">
                        <Run Text="{DynamicResource Footer.Left}" />
                        <Run Text=" · " />
                        <Run Text="{Binding WindowsVersionText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Grid.Column="1" Text="{DynamicResource Footer.Right}" FontSize="10.5"
                               Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"
                               Margin="16,0,0,0" TextWrapping="Wrap" />
                </Grid>
            </Border>

            <!-- First-run welcome overlay. Original choreography adapted softly to Violet Light/Dark theme. -->
            <Grid x:Name="OnboardingOverlay" Grid.RowSpan="3" Panel.ZIndex="20" Visibility="Collapsed"
                  Background="{DynamicResource BrushBgApp}" ClipToBounds="True">

                <!-- Ambient Backdrop Card (Modern rounded glass container replacing the oval) -->
                <Border x:Name="OnbAmbientGlow" Width="640" Height="480" CornerRadius="28"
                        Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorderStrong}"
                        BorderThickness="1" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsHitTestVisible="False" />

                <!-- Subtle Corner Brackets -->
                <Grid x:Name="OnbHudBrackets" IsHitTestVisible="False" Opacity="0" Margin="36">
                    <Border Width="34" Height="34" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1.5,1.5,0,0"
                            HorizontalAlignment="Left" VerticalAlignment="Top" />
                    <Border Width="34" Height="34" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="0,1.5,1.5,0"
                            HorizontalAlignment="Right" VerticalAlignment="Top" />
                    <Border Width="34" Height="34" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1.5,0,0,1.5"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                    <Border Width="34" Height="34" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="0,0,1.5,1.5"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                </Grid>

                <!-- Main Showcase Hub Content -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="680" Margin="28">

                    <!-- Engine Status Pill Tag -->
                    <Border x:Name="OnbStatusPill" Background="{DynamicResource BrushBadgeSoft}"
                            BorderBrush="{DynamicResource BrushBorderGlow}" BorderThickness="1" CornerRadius="16"
                            Padding="14,5" HorizontalAlignment="Center" Margin="0,0,0,22"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="OnbStatusPillTranslate" Y="0" />
                        </Border.RenderTransform>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource BrushSuccess}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="GAME OPTIMIZATION ENGINE // INITIAL SETUP"
                                       Foreground="{DynamicResource BrushVioletText}" FontSize="10.5" FontWeight="Bold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Hero Brand Monolith with Concentric Soft Rings -->
                    <Grid x:Name="OnbHeroIcon" Width="110" Height="110" HorizontalAlignment="Center" Margin="0,0,0,18"
                          RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="OnbHeroScale" ScaleX="1" ScaleY="1" />
                                <TranslateTransform x:Name="OnbHeroTranslate" Y="0" />
                            </TransformGroup>
                        </Grid.RenderTransform>

                        <Border Width="110" Height="110" CornerRadius="34"
                                Background="{DynamicResource BrushHeroRingOuter}"
                                BorderBrush="{DynamicResource BrushBorderGlow}" BorderThickness="1"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />

                        <Border Width="92" Height="92" CornerRadius="28"
                                Background="{DynamicResource BrushHeroRingCore}"
                                BorderBrush="{DynamicResource BrushBorderAccent}" BorderThickness="1.2"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />

                        <Border Width="74" Height="74" CornerRadius="22"
                                Background="{DynamicResource BrushAccentGradient}"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="{StaticResource Icon.BoltFill}" Fill="{DynamicResource BrushOnAccent}"
                                  Width="25" Height="36" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <!-- Dynamic Multilingual Heading -->
                    <StackPanel x:Name="OnbHeadingGroup" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="OnbHeadingTranslate" Y="0" />
                        </StackPanel.RenderTransform>

                        <TextBlock x:Name="WelcomeText" Text="Welcome" FontSize="40" FontWeight="Bold"
                                   Foreground="{DynamicResource BrushTextPrimary}"
                                   HorizontalAlignment="Center" Margin="0,0,0,7" TextAlignment="Center"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="WelcomeTextTranslate" Y="0" />
                            </TextBlock.RenderTransform>
                        </TextBlock>

                        <Border x:Name="WelcomeLanguageBadge" Background="{DynamicResource BrushBadgeSoft}"
                                BorderBrush="{DynamicResource BrushBorderGlow}" BorderThickness="1" CornerRadius="7"
                                Padding="12,4" HorizontalAlignment="Center" Margin="0,0,0,11"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="WelcomeLanguageTranslate" Y="0" />
                            </Border.RenderTransform>
                            <TextBlock x:Name="WelcomeLanguage" Text="English"
                                       Foreground="{DynamicResource BrushVioletText}" FontSize="11.5" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                        </Border>

                        <TextBlock x:Name="OnbTagline" Text="{DynamicResource Onb.Tagline}" FontSize="14" FontWeight="Normal"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   HorizontalAlignment="Center" Margin="0,2,0,0" TextAlignment="Center" />
                    </StackPanel>

                    <!-- Compact Language Selector Capsule -->
                    <Border x:Name="OnbLangCapsule" Background="{DynamicResource BrushCardBg}"
                            BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1"
                            CornerRadius="12" Padding="12,8" HorizontalAlignment="Center" Margin="0,22,0,22"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="OnbLangTranslate" Y="0" />
                        </Border.RenderTransform>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{DynamicResource BrushBadgeSoft}" CornerRadius="8" Width="28" Height="28"
                                    Margin="0,0,10,0" VerticalAlignment="Center">
                                <controls:AppIcon Data="{StaticResource Icon.Globe}" Size="14"
                                                  Foreground="{DynamicResource BrushAccent}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{DynamicResource Onb.Language}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ComboBox x:Name="OnboardingLanguageCombo" Style="{StaticResource DarkComboBox}"
                                      Width="136" DisplayMemberPath="NativeName"
                                      VerticalAlignment="Center"
                                      SelectionChanged="OnboardingLanguage_SelectionChanged" />
                        </StackPanel>
                    </Border>

                    <!-- Master Action CTA Button -->
                    <Button x:Name="OnbContinueBtn" Style="{StaticResource PrimaryButton}" Padding="44,13"
                            HorizontalAlignment="Center" Click="OnOnboardingContinue"
                            RenderTransformOrigin="0.5,0.5">
                        <Button.RenderTransform>
                            <TranslateTransform x:Name="OnbContinueTranslate" Y="0" />
                        </Button.RenderTransform>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Onb.Continue}" FontSize="14.5" FontWeight="Bold"
                                       Foreground="{DynamicResource BrushOnAccent}" Margin="0,0,10,0" />
                            <controls:AppIcon Data="{StaticResource Icon.ArrowRight}" Size="15"
                                              Foreground="{DynamicResource BrushOnAccent}" />
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Grid>

            <!-- Close / tray decision dialog -->
            <Grid x:Name="CloseConfirmationOverlay" Grid.RowSpan="3" Panel.ZIndex="30" Visibility="Collapsed"
                  Background="{DynamicResource BrushOverlayScrim}" MouseLeftButtonDown="CloseConfirmationOverlay_MouseDown">
                <Grid Width="470" MaxWidth="620" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.RenderTransform><ScaleTransform x:Name="CloseModalScale" ScaleX="1" ScaleY="1" /></Grid.RenderTransform>
                    <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1" CornerRadius="18" Padding="24"
                            MouseLeftButtonDown="CloseModalCard_MouseDown">
                        <StackPanel>
                            <Grid Margin="0,0,0,17">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="25" Height="25" Background="{DynamicResource BrushAccentSoft}" CornerRadius="7" Margin="0,0,8,0">
                                        <controls:AppIcon Data="{StaticResource Icon.Power}" Size="13" Foreground="{DynamicResource BrushAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="SMOOTHFRAME" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource TitleBarButton}" Width="28" Height="28"
                                        Padding="0" Click="CloseDialogCancel_Click" ToolTip="{DynamicResource Dialog.Close.Cancel}">
                                    <controls:AppIcon Data="{StaticResource Icon.Close}" Size="12" />
                                </Button>
                            </Grid>
                            <TextBlock Text="{DynamicResource Dialog.Close.Title}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="{DynamicResource Dialog.Close.Desc}" Style="{StaticResource TextBody}" Margin="0,0,0,18" />

                            <Button Style="{StaticResource CloseDialogTrayButton}" Click="CloseDialogTray_Click" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Width="38" Height="38" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="10" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <controls:AppIcon Data="{StaticResource Icon.RestoreWindow}" Size="17" Foreground="{DynamicResource BrushAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Dialog.Close.Tray}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" TextWrapping="Wrap" />
                                        <TextBlock Text="{DynamicResource Dialog.Close.TrayDesc}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource CloseDialogExitButton}" Click="CloseDialogExit_Click" Margin="0,0,0,18">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Width="38" Height="38" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushDangerBorder}" BorderThickness="1" CornerRadius="10" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <controls:AppIcon Data="{StaticResource Icon.Close}" Size="15" Foreground="{DynamicResource BrushDanger}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Dialog.Close.Exit}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" TextWrapping="Wrap" />
                                        <TextBlock Text="{DynamicResource Dialog.Close.ExitDesc}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <CheckBox x:Name="CloseRememberCheckBox" Style="{StaticResource SwitchStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{DynamicResource Dialog.Close.Remember}" FontSize="11.5"
                                           Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="10,0,8,0"
                                           MouseDown="CloseRememberLabel_MouseDown" />
                                <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Padding="16,7"
                                        Click="CloseDialogCancel_Click">
                                    <TextBlock Text="{DynamicResource Dialog.Close.Cancel}" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Update available dialog modal -->
            <Grid x:Name="UpdateNotificationOverlay" Grid.RowSpan="3" Panel.ZIndex="35" Visibility="Collapsed"
                  Background="{DynamicResource BrushOverlayScrim}">
                <Grid Width="480" MaxWidth="620" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.RenderTransform><ScaleTransform x:Name="UpdateModalScale" ScaleX="1" ScaleY="1" /></Grid.RenderTransform>
                    <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1" CornerRadius="18" Padding="24">
                        <StackPanel>
                            <!-- Header / Badge + Close -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="26" Height="26" Background="{DynamicResource BrushAccentSoft}" CornerRadius="7" Margin="0,0,9,0">
                                        <controls:AppIcon Data="{StaticResource Icon.Bolt}" Size="14" Foreground="{DynamicResource BrushAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{DynamicResource Update.Badge}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushVioletText}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource TitleBarButton}" Width="28" Height="28"
                                        Padding="0" Click="UpdateDialogDismiss_Click">
                                    <controls:AppIcon Data="{StaticResource Icon.Close}" Size="12" />
                                </Button>
                            </Grid>

                            <!-- Heading -->
                            <TextBlock x:Name="UpdateDialogTitle" Text="{DynamicResource Update.Title}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12" />

                            <!-- Version Comparison Card -->
                            <Border Background="{DynamicResource BrushBgInset}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{DynamicResource Update.Current}" Style="{StaticResource TextCaption}" />
                                        <TextBlock x:Name="UpdateCurVerText" Text="v3.0.0" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="➔" FontSize="14" Foreground="{DynamicResource BrushVioletText}" VerticalAlignment="Center" Margin="12,0" />

                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                        <TextBlock Text="{DynamicResource Update.New}" Style="{StaticResource TextCaption}" HorizontalAlignment="Right" />
                                        <Border Background="{DynamicResource BrushAccentSoft}" BorderBrush="{DynamicResource BrushBorderGlow}" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,3,0,0">
                                            <TextBlock x:Name="UpdateNewVerText" Text="v3.1.0" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushVioletText}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Release notes preview -->
                            <TextBlock x:Name="UpdateReleaseNotesText" Text="{DynamicResource Update.Desc}" Style="{StaticResource TextBody}" TextWrapping="Wrap" Margin="0,0,0,20" MaxHeight="80" TextTrimming="CharacterEllipsis" />

                            <!-- Action Buttons -->
                            <StackPanel>
                                <Button x:Name="UpdateDownloadBtn" Style="{StaticResource PrimaryButton}" Padding="20,12" Margin="0,0,0,10" Click="UpdateDialogDownload_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <controls:AppIcon Data="{StaticResource Icon.Download}" Size="15" Margin="0,0,8,0" Foreground="{DynamicResource BrushOnAccent}" />
                                        <TextBlock Text="{DynamicResource Update.Download}" FontWeight="Bold" />
                                    </StackPanel>
                                </Button>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Remind Later Dropdown -->
                                    <ComboBox x:Name="UpdateRemindCombo" Grid.Column="0" Style="{StaticResource DarkComboBox}" Height="36"
                                              SelectionChanged="UpdateRemindCombo_SelectionChanged" />

                                    <!-- Skip Version Button -->
                                    <Button x:Name="UpdateSkipVersionBtn" Grid.Column="2" Style="{StaticResource SecondaryButton}" Height="36" Padding="6,0" Click="UpdateDialogSkip_Click">
                                        <TextBlock Text="{DynamicResource Update.SkipVersion}" FontSize="11.5" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
