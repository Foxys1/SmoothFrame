                                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding Category}" FontSize="10.5" Foreground="{DynamicResource BrushVioletText}" Margin="0,3,0,0" />
                                                            <TextBlock Text="{Binding Description}" Style="{StaticResource TextCaption}" Margin="0,4,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </controls:SmoothScrollViewer>
                    </Grid>

                    <!-- ==================== SETTINGS ==================== -->
                    <Grid x:Name="PageSettings" Visibility="Collapsed">
                        <controls:SmoothScrollViewer Style="{StaticResource DarkScrollViewer}">
                            <StackPanel Margin="26,24,26,30">
                                <TextBlock Text="{DynamicResource Sett.Title}" Style="{StaticResource PageHeaderTitle}" />
                                <TextBlock Text="{DynamicResource Sett.Subtitle}" Style="{StaticResource TextBody}" Margin="0,0,0,20" />

                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <StackPanel Margin="2,0,0,10">
                                            <TextBlock Text="{DynamicResource Set.Group.Core}" Style="{StaticResource TextSection}" />
                                            <TextBlock Text="{DynamicResource Set.Group.CoreDesc}" Style="{StaticResource TextCaption}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <Border Style="{StaticResource Card}" Padding="12">
                                            <StackPanel>
                                                <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="{DynamicResource Set.Timer.Title}" FontSize="12.5" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource Set.Timer.Desc}" Style="{StaticResource TextCaption}" Margin="0,3,0,0" /></StackPanel><CheckBox Grid.Column="1" Style="{StaticResource SwitchStyle}" IsChecked="{Binding HighPrecisionTimer, Mode=TwoWay}" /></Grid></Border>
                                                <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="{DynamicResource Set.Power.Title}" FontSize="12.5" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource Set.Power.Desc}" Style="{StaticResource TextCaption}" Margin="0,3,0,0" /></StackPanel><CheckBox Grid.Column="1" Style="{StaticResource SwitchStyle}" IsChecked="{Binding HighPerformancePlan, Mode=TwoWay}" /></Grid></Border>
                                                <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="{DynamicResource Set.Cores.Title}" FontSize="12.5" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource Set.Cores.Desc}" Style="{StaticResource TextCaption}" Margin="0,3,0,0" /></StackPanel><CheckBox Grid.Column="1" Style="{StaticResource SwitchStyle}" IsChecked="{Binding IsolatePCores, Mode=TwoWay}" /></Grid></Border>
                                                <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="{DynamicResource Set.Bg.Title}" FontSize="12.5" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource Set.Bg.Desc}" Style="{StaticResource TextCaption}" Margin="0,3,0,0" /></StackPanel><CheckBox Grid.Column="1" Style="{StaticResource SwitchStyle}" IsChecked="{Binding DeprioritizeBackground, Mode=TwoWay}" /></Grid></Border>
                                                <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="{DynamicResource Set.Network.Title}" FontSize="12.5" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource Set.Network.Desc}" Style="{StaticResource TextCaption}" Margin="0,3,0,0" /></StackPanel><CheckBox Grid.Column="1" Style="{StaticResource SwitchStyle}" IsChecked="{Binding OptimizeNetwork, Mode=TwoWay}" /></Grid></Border>
                                                <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="{DynamicResource Set.Io.Title}" FontSize="12.5" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource Set.Io.Desc}" Style="{StaticResource TextCaption}" Margin="0,3,0,0" /></StackPanel><CheckBox Grid.Column="1" Style="{StaticResource SwitchStyle}" IsChecked="{Binding OptimizeIoPriority, Mode=TwoWay}" /></Grid></Border>
                                                <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="{DynamicResource Set.Audio.Title}" FontSize="12.5" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource Set.Audio.Desc}" Style="{StaticResource TextCaption}" Margin="0,3,0,0" /></StackPanel><CheckBox Grid.Column="1" Style="{StaticResource SwitchStyle}" IsChecked="{Binding OptimizeAudioDg, Mode=TwoWay}" /></Grid></Border>
                                                <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="{DynamicResource Set.Qos.Title}" FontSize="12.5" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource Set.Qos.Desc}" Style="{StaticResource TextCaption}" Margin="0,3,0,0" /></StackPanel><CheckBox Grid.Column="1" Style="{StaticResource SwitchStyle}" IsChecked="{Binding ProcessQosEnabled, Mode=TwoWay}" /></Grid></Border>
                                                <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="{DynamicResource Set.WinGame.Title}" FontSize="12.5" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource Set.WinGame.Desc}" Style="{StaticResource TextCaption}" Margin="0,3,0,0" /></StackPanel><CheckBox Grid.Column="1" Style="{StaticResource SwitchStyle}" IsChecked="{Binding WindowedGameOptimization, Mode=TwoWay}" /></Grid></Border>
                                                <Border Style="{StaticResource SettingRow}" Margin="0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="{DynamicResource Set.Mouse.Title}" FontSize="12.5" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource Set.Mouse.Desc}" Style="{StaticResource TextCaption}" Margin="0,3,0,0" /></StackPanel><CheckBox Grid.Column="1" Style="{StaticResource SwitchStyle}" IsChecked="{Binding LinearMouseInput, Mode=TwoWay}" /></Grid></Border>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <StackPanel Margin="2,0,0,10">
                                            <TextBlock Text="{DynamicResource Set.Group.Automation}" Style="{StaticResource TextSection}" />
                                            <TextBlock Text="{DynamicResource Set.Group.AutomationDesc}" Style="{StaticResource TextCaption}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,18">
                                            <StackPanel>
                                                <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="{DynamicResource Set.AutoBoost.Title}" FontSize="12.5" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource Set.AutoBoost.Desc}" Style="{StaticResource TextCaption}" Margin="0,3,0,0" /></StackPanel><CheckBox Grid.Column="1" Style="{StaticResource SwitchStyle}" IsChecked="{Binding AutoBoostOnGameLaunch, Mode=TwoWay}" /></Grid></Border>
                                                <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="{DynamicResource Set.Hotkey.Title}" FontSize="12.5" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource Set.Hotkey.Desc}" Style="{StaticResource TextCaption}" Margin="0,3,0,0" /></StackPanel><CheckBox Grid.Column="1" Style="{StaticResource SwitchStyle}" IsChecked="{Binding GlobalHotkeyEnabled, Mode=TwoWay}" /></Grid></Border>
                                                <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="{DynamicResource Set.Autostart.Title}" FontSize="12.5" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource Set.Autostart.Desc}" Style="{StaticResource TextCaption}" Margin="0,3,0,0" /></StackPanel><CheckBox Grid.Column="1" Style="{StaticResource SwitchStyle}" IsChecked="{Binding AutostartEnabled, Mode=TwoWay}" /></Grid></Border>
                                                <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="{DynamicResource Set.ClosePrompt.Title}" FontSize="12.5" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource Set.ClosePrompt.Desc}" Style="{StaticResource TextCaption}" Margin="0,3,0,0" /></StackPanel><CheckBox Grid.Column="1" Style="{StaticResource SwitchStyle}" IsChecked="{Binding PromptOnClose, Mode=TwoWay}" /></Grid></Border>
                                                <Border Style="{StaticResource SettingRow}" Margin="0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="{DynamicResource Set.Tray.Title}" FontSize="12.5" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource Set.Tray.Desc}" Style="{StaticResource TextCaption}" Margin="0,3,0,0" /></StackPanel><CheckBox Grid.Column="1" Style="{StaticResource SwitchStyle}" IsChecked="{Binding MinimizeToTrayOnClose, Mode=TwoWay}" /></Grid></Border>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Margin="2,0,0,10">
                                            <TextBlock Text="{DynamicResource Set.Group.App}" Style="{StaticResource TextSection}" />
                                            <TextBlock Text="{DynamicResource Set.Group.AppDesc}" Style="{StaticResource TextCaption}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <Border Style="{StaticResource Card}" Padding="16">
                                            <StackPanel>
                                                <Border Style="{StaticResource SettingRow}" Margin="0,0,0,14">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <StackPanel Margin="0,0,12,0">
                                                            <TextBlock Text="{DynamicResource Set.Theme.Title}" FontSize="12.5" FontWeight="SemiBold" />
                                                            <TextBlock Text="{DynamicResource Set.Theme.Desc}" Style="{StaticResource TextCaption}" Margin="0,3,0,0" />
                                                        </StackPanel>
                                                        <CheckBox Grid.Column="1" Style="{StaticResource SwitchStyle}" IsChecked="{Binding IsDarkTheme, Mode=TwoWay}" />
                                                    </Grid>
                                                </Border>
                                                <TextBlock Text="{DynamicResource Set.Lang.Title}" FontSize="12.5" FontWeight="SemiBold" />
                                                <TextBlock Text="{DynamicResource Set.Lang.Desc}" Style="{StaticResource TextCaption}" Margin="0,3,0,10" />
                                                <ComboBox x:Name="LanguageCombo" Style="{StaticResource DarkComboBox}"
                                                          DisplayMemberPath="NativeName"
                                                          SelectionChanged="LanguageCombo_SelectionChanged" />
                                                <Border Style="{StaticResource CardInset}" Padding="12,10" Margin="0,14,0,0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <StackPanel Margin="0,0,10,0">
                                                            <TextBlock Text="{DynamicResource Set.Engine.Title}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                            <TextBlock Text="{DynamicResource Set.Engine.Desc}" Style="{StaticResource TextCaption}" Margin="0,3,0,0" />
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Background="{DynamicResource BrushSuccessTint}" BorderBrush="{DynamicResource BrushSuccessBorder}" BorderThickness="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Top">
                                                            <TextBlock Text="{DynamicResource Set.Engine.Badge}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource BrushSuccess}" />
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <!-- Check for Updates row -->
                                                <Border Style="{StaticResource CardInset}" Padding="12,10" Margin="0,10,0,0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{DynamicResource Update.SettingsTitle}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                            <TextBlock x:Name="SettingsUpdateStatusText" Text="{DynamicResource Update.SettingsDesc}" Style="{StaticResource TextCaption}" Margin="0,3,0,0" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Padding="14,6" VerticalAlignment="Center" Click="CheckUpdatesButton_Click">
                                                            <TextBlock Text="{DynamicResource Update.CheckBtn}" FontSize="11.5" />
                                                        </Button>
                                                    </Grid>
                                                </Border>

                                                <!-- Pause Updates (Windows-style, up to 1 month) -->
                                                <Border Style="{StaticResource CardInset}" Padding="12,12" Margin="0,10,0,0">
                                                    <StackPanel>
                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{DynamicResource Update.PauseTitle}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                <TextBlock Text="{DynamicResource Update.PauseDesc}" Style="{StaticResource TextCaption}" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                            <Button x:Name="ResumeUpdatesBtn" Grid.Column="1" Style="{StaticResource SecondaryButton}" Padding="12,5"
                                                                    VerticalAlignment="Center" Visibility="Collapsed" Click="ResumeUpdatesBtn_Click">
                                                                <TextBlock Text="{DynamicResource Update.ResumeBtn}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushVioletText}" />
                                                            </Button>
                                                        </Grid>

                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <ComboBox x:Name="PauseUpdatesCombo" Style="{StaticResource DarkComboBox}" Height="34"
                                                                      SelectionChanged="PauseUpdatesCombo_SelectionChanged" />
                                                            <Border x:Name="PauseStatusBadge" Grid.Column="1" Margin="10,0,0,0" Background="{DynamicResource BrushAccentSoft}"
                                                                    BorderBrush="{DynamicResource BrushBorderGlow}" BorderThickness="1" CornerRadius="6" Padding="8,4"
                                                                    VerticalAlignment="Center" Visibility="Collapsed">
                                                                <TextBlock x:Name="PauseStatusBadgeText" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushVioletText}" />
                                                            </Border>
                                                        </Grid>

                                                        <!-- Skipped Version Notice if present -->
                                                        <Border x:Name="SkippedVersionPanel" Margin="0,10,0,0" Background="{DynamicResource BrushBgInset}"
                                                                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="10,8"
                                                                Visibility="Collapsed">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="{DynamicResource Update.SkippedVersionNotice}" Style="{StaticResource TextCaption}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                    <TextBlock x:Name="SkippedVersionLabel" Text="v2.4.0" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Padding="10,4" Click="ResetSkippedVersion_Click">
                                                                    <TextBlock Text="{DynamicResource Update.ResetSkipBtn}" FontSize="11" />
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </controls:SmoothScrollViewer>
                    </Grid>

                    <!-- ==================== PROTECTION ==================== -->
                    <Grid x:Name="PageProtect" Visibility="Collapsed">
                        <controls:SmoothScrollViewer Style="{StaticResource DarkScrollViewer}">
                            <StackPanel Margin="26,24,26,30">
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Prot.Title}" Style="{StaticResource PageHeaderTitle}" />
                                        <TextBlock Text="{DynamicResource Prot.Subtitle}" Style="{StaticResource TextBody}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource BrushSuccessTint}" BorderBrush="{DynamicResource BrushSuccessBorder}" BorderThickness="1"
                                            CornerRadius="8" Padding="10,7" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Prot.Badge}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushSuccess}" TextWrapping="Wrap" />
                                    </Border>
                                </Grid>

                                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40" CornerRadius="11" Background="{DynamicResource BrushAccentSoft}" VerticalAlignment="Top">
                                            <controls:AppIcon Data="{StaticResource Icon.ShieldCheck}" Size="19" Foreground="{DynamicResource BrushAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{DynamicResource Prot.Zero.Title}" Style="{StaticResource TextSection}" />
                                            <TextBlock Text="{DynamicResource Prot.Zero.Desc}" Style="{StaticResource TextBody}" Margin="0,4,0,12" />
                                            <TextBlock Text="{DynamicResource Prot.Zero.P1}" Style="{StaticResource TextBody}" Margin="0,3,0,0" />
                                            <TextBlock Text="{DynamicResource Prot.Zero.P2}" Style="{StaticResource TextBody}" Margin="0,3,0,0" />
                                            <TextBlock Text="{DynamicResource Prot.Zero.P3}" Style="{StaticResource TextBody}" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40" CornerRadius="11" Background="{DynamicResource BrushBadgeSoft}" VerticalAlignment="Top">
                                            <controls:AppIcon Data="{StaticResource Icon.Restore}" Size="19" Foreground="{DynamicResource BrushInfo}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{DynamicResource Prot.Rev.Title}" Style="{StaticResource TextSection}" />
                                            <TextBlock Text="{DynamicResource Prot.Rev.Desc}" Style="{StaticResource TextBody}" Margin="0,4,0,12" />
                                            <TextBlock Text="{DynamicResource Prot.Rev.P1}" Style="{StaticResource TextBody}" Margin="0,3,0,0" />
                                            <TextBlock Text="{DynamicResource Prot.Rev.P2}" Style="{StaticResource TextBody}" Margin="0,3,0,0" />
                                            <TextBlock Text="{DynamicResource Prot.Rev.P3}" Style="{StaticResource TextBody}" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,18">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40" CornerRadius="11" Background="{DynamicResource BrushWarningTint}" VerticalAlignment="Top">
                                            <controls:AppIcon Data="{StaticResource Icon.Lock}" Size="19" Foreground="{DynamicResource BrushWarning}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{DynamicResource Prot.Crash.Title}" Style="{StaticResource TextSection}" />
                                            <TextBlock Text="{DynamicResource Prot.Crash.Desc}" Style="{StaticResource TextBody}" Margin="0,4,0,12" />
                                            <TextBlock Text="{DynamicResource Prot.Crash.P1}" Style="{StaticResource TextBody}" Margin="0,3,0,0" />
                                            <TextBlock Text="{DynamicResource Prot.Crash.P2}" Style="{StaticResource TextBody}" Margin="0,3,0,0" />
                                            <TextBlock Text="{DynamicResource Prot.Crash.P3}" Style="{StaticResource TextBody}" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource Card}" Padding="18">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Prot.Chips.Title}" Style="{StaticResource TextCaption}" FontWeight="Bold" Margin="0,0,0,12" />
                                        <WrapPanel>
                                            <Border Background="{DynamicResource BrushAccentSoft}" BorderBrush="{DynamicResource BrushBorderGlow}" BorderThickness="1" CornerRadius="7" Padding="10,6" Margin="0,0,8,8"><TextBlock Text="Win32 API" FontSize="11" Foreground="{DynamicResource BrushVioletText}" /></Border>
                                            <Border Background="{DynamicResource BrushAccentSoft}" BorderBrush="{DynamicResource BrushBorderGlow}" BorderThickness="1" CornerRadius="7" Padding="10,6" Margin="0,0,8,8"><TextBlock Text="No injection" FontSize="11" Foreground="{DynamicResource BrushVioletText}" /></Border>
                                            <Border Background="{DynamicResource BrushAccentSoft}" BorderBrush="{DynamicResource BrushBorderGlow}" BorderThickness="1" CornerRadius="7" Padding="10,6" Margin="0,0,8,8"><TextBlock Text="Rollback" FontSize="11" Foreground="{DynamicResource BrushVioletText}" /></Border>
                                            <Border Background="{DynamicResource BrushAccentSoft}" BorderBrush="{DynamicResource BrushBorderGlow}" BorderThickness="1" CornerRadius="7" Padding="10,6" Margin="0,0,8,8"><TextBlock Text="Local processing" FontSize="11" Foreground="{DynamicResource BrushVioletText}" /></Border>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </controls:SmoothScrollViewer>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Status footer -->
            <Border x:Name="FooterBorder" Grid.Row="2" Background="{DynamicResource BrushBgSide}"
