<Window x:Class="SmoothFrame.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:SmoothFrame.UI.Controls"
        xmlns:converters="clr-namespace:SmoothFrame.UI.Converters"
        mc:Ignorable="d"
        Title="{DynamicResource App.Title}"
        Height="790" Width="1180"
        MinHeight="680" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Foreground="{StaticResource BrushTextPrimary}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48"
                      ResizeBorderThickness="8"
                      GlassFrameThickness="0"
                      CornerRadius="16" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DropShadowEffect x:Key="WindowDropShadow" Color="#8B5CF6" BlurRadius="28" ShadowDepth="4" Opacity="0.35"/>
        <converters:Base64ToImageConverter x:Key="Base64ToImageConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisConverter" />

        <SolidColorBrush x:Key="BrushSuccessTint" Color="#0D2E20"/>
        <SolidColorBrush x:Key="BrushWarningTint" Color="#30200A"/>
        <SolidColorBrush x:Key="BrushDangerHover" Color="#FB7185"/>
        <SolidColorBrush x:Key="BrushDangerPressed" Color="#E11D48"/>

        <Style x:Key="EmptyHint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,40,0,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasItems, ElementName=GamesList}" Value="False">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Master Hero Boost Button with smooth scale micro-interaction and glow -->
        <Style x:Key="HeroButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource BrushAccentGradient}" CornerRadius="12"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#8B5CF6" BlurRadius="22" ShadowDepth="2" Opacity="0.55"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushAccentGradientHover}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.03" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.03" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushAccentPressed}"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsOptimizing}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushDangerGradient}"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsOptimizing}" Value="True"/>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushDangerGradientHover}"/>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minecraft Master Hero Button -->
        <Style x:Key="MinecraftHeroButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource BrushAccentGradient}" CornerRadius="12"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#8B5CF6" BlurRadius="22" ShadowDepth="2" Opacity="0.55"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushAccentGradientHover}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.03" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.03" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushAccentPressed}"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsMinecraftOptimizing}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushDangerGradient}"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMinecraftOptimizing}" Value="True"/>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushDangerGradientHover}"/>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Bento Horizontal Game Card Item -->
        <Style x:Key="GameCardItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="CardBd"
                                Background="{StaticResource BrushBgCard}"
                                BorderBrush="{StaticResource BrushTopHighlightBorder}"
                                BorderThickness="1.2"
                                CornerRadius="12"
                                Width="204" Height="70"
                                Margin="4"
                                Padding="10,8"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
                            </Border.Effect>
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBd" Property="Background" Value="{StaticResource BrushBgCardHover}"/>
                                <Setter TargetName="CardBd" Property="BorderBrush" Value="{StaticResource BrushAccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CardBd" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                <Setter TargetName="CardBd" Property="BorderThickness" Value="1.5"/>
                                <Setter TargetName="CardBd" Property="Background" Value="{StaticResource BrushNavActiveBg}"/>
                                <Setter TargetName="CardBd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#8B5CF6" BlurRadius="14" ShadowDepth="0" Opacity="0.45"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close Confirmation Dialog Option Button (Tray) -->
        <Style x:Key="CloseDialogTrayButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <!-- Background glow layer (contains no text, so text is never rasterized/blurred) -->
                            <Border x:Name="GlowBd" Background="{StaticResource BrushAccent}" CornerRadius="12" Opacity="0">
                                <Border.Effect>
                                    <DropShadowEffect Color="#8B5CF6" BlurRadius="18" ShadowDepth="0" Opacity="0.5"/>
                                </Border.Effect>
                            </Border>

                            <!-- Sharp card surface -->
                            <Border x:Name="Bd" Background="#171228" BorderBrush="#3D2968" BorderThickness="1.5" CornerRadius="12"
                                    SnapsToDevicePixels="True" UseLayoutRounding="True"
                                    RenderOptions.ClearTypeHint="Enabled">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GlowBd" Property="Opacity" Value="0.25"/>
                                <Setter TargetName="Bd" Property="Background" Value="#251B42"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="GlowBd" Property="Opacity" Value="0.1"/>
                                <Setter TargetName="Bd" Property="Background" Value="#130E20"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close Confirmation Dialog Option Button (Exit) -->
        <Style x:Key="CloseDialogExitButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <!-- Background glow layer (contains no text, so text is never rasterized/blurred) -->
                            <Border x:Name="GlowBd" Background="#EF4444" CornerRadius="12" Opacity="0">
                                <Border.Effect>
                                    <DropShadowEffect Color="#EF4444" BlurRadius="18" ShadowDepth="0" Opacity="0.5"/>
                                </Border.Effect>
                            </Border>

                            <!-- Sharp card surface -->
                            <Border x:Name="Bd" Background="#1C1117" BorderBrush="#4A1E29" BorderThickness="1.5" CornerRadius="12"
                                    SnapsToDevicePixels="True" UseLayoutRounding="True"
                                    RenderOptions.ClearTypeHint="Enabled">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GlowBd" Property="Opacity" Value="0.25"/>
                                <Setter TargetName="Bd" Property="Background" Value="#29131D"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#F87171"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="GlowBd" Property="Opacity" Value="0.1"/>
                                <Setter TargetName="Bd" Property="Background" Value="#140D11"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#DC2626"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer window border with 16px CornerRadius, vibrant border gradient, and soft drop shadow -->
    <Border x:Name="RootBorder" BorderBrush="{StaticResource BrushBorderGradient}" BorderThickness="1.5" CornerRadius="16"
            Background="{StaticResource BrushBgApp}"
            RenderOptions.ClearTypeHint="Enabled"
            SnapsToDevicePixels="True"
            Effect="{StaticResource WindowDropShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="32"/>
            </Grid.RowDefinitions>

            <!-- ===================== TITLE BAR ===================== -->
            <Border x:Name="TitleBarBorder" Grid.Row="0" Background="{StaticResource BrushBgSide}"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1"
                    CornerRadius="15,15,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Brand identity with neon violet gradient container, PRO badge, and live latency pill -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Border Background="{StaticResource BrushAccentGradient}" CornerRadius="8" Width="28" Height="28">
                            <Border.Effect>
                                <DropShadowEffect Color="#8B5CF6" BlurRadius="10" ShadowDepth="0" Opacity="0.6"/>
                            </Border.Effect>
                            <Path Data="{StaticResource Icon.BoltFill}" Fill="#FFFFFF" Stretch="Uniform"
                                  Width="10" Height="14"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="SmoothFrame" FontSize="14" FontWeight="Bold"
                                   Foreground="#FFFFFF"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <!-- Glowing PRO badge -->
                        <Border Background="{StaticResource BrushNavActiveBg}" BorderBrush="{StaticResource BrushBorderGlow}" BorderThickness="1"
                                CornerRadius="6" Padding="6,2"
                                Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="PRO" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource BrushAccentHover}"/>
                        </Border>
                        <Border Background="{StaticResource BrushAccentSoft}" BorderBrush="#4C1D95" BorderThickness="1"
                                CornerRadius="6" Padding="8,2"
                                Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Badge.Safe}" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushVioletText}"/>
                        </Border>

                        <!-- Live Dynamic Status Pill in Title Bar -->
                        <Border Background="#0A0A10" BorderBrush="#1C1B2C" BorderThickness="1"
                                CornerRadius="12" Padding="10,3" Margin="16,0,0,0" VerticalAlignment="Center"
                                ToolTip="SmoothFrame Low-Latency Optimization Engine">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource BrushAccentHover}"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#8B5CF6" BlurRadius="6" ShadowDepth="0" Opacity="0.8"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOptimizing}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource BrushSuccess}"/>
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect Color="#10B981" BlurRadius="6" ShadowDepth="0" Opacity="0.9"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Text" Value="{DynamicResource TitleBar.Standby}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOptimizing}" Value="True">
                                                    <Setter Property="Text" Value="{DynamicResource TitleBar.Active}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource BrushSuccess}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Window controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource TitleBarButton}" Click="MinimizeButton_Click">
                            <controls:AppIcon Data="{StaticResource Icon.Min}" Size="12"/>
                        </Button>
                        <Button x:Name="BtnMaximize" Style="{StaticResource TitleBarButton}" Click="MaximizeButton_Click">
                            <controls:AppIcon x:Name="MaximizeIcon" Data="{StaticResource Icon.Max}" Size="11"/>
                        </Button>
                        <Button Style="{StaticResource TitleBarCloseButton}" Click="CloseButton_Click">
                            <controls:AppIcon Data="{StaticResource Icon.Close}" Size="11"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===================== BODY ===================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- = Sidebar Navigation = -->
                <Border Grid.Column="0" Background="{StaticResource BrushBgSide}"
                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{DynamicResource Nav.Caption}"
                                   Style="{StaticResource TextCaption}" FontWeight="Bold"
                                   Margin="22,18,0,12"/>

                        <StackPanel Grid.Row="1">
                            <RadioButton x:Name="NavOpt" GroupName="Nav" Style="{StaticResource SideNavItem}"
                                         Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <controls:AppIcon Data="{StaticResource Icon.Gauge}" Size="16" Margin="0,0,12,0"/>
                                    <TextBlock Text="{DynamicResource Nav.Opt}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavMinecraft" GroupName="Nav" Style="{StaticResource SideNavItem}"
                                         Checked="Nav_Checked">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <controls:AppIcon Data="{StaticResource Icon.Game}" Size="16" Margin="0,0,12,0"/>
                                        <TextBlock Text="{DynamicResource Nav.Minecraft}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" HorizontalAlignment="Right" Background="#261245" BorderBrush="#8B5CF6" BorderThickness="1"
                                            CornerRadius="4" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="FPS PRO" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushVioletText}"/>
                                    </Border>
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="NavSettings" GroupName="Nav" Style="{StaticResource SideNavItem}"
                                         Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <controls:AppIcon Data="{StaticResource Icon.Settings}" Size="16" Margin="0,0,12,0"/>
                                    <TextBlock Text="{DynamicResource Nav.Settings}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavProtect" GroupName="Nav" Style="{StaticResource SideNavItem}"
                                         Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <controls:AppIcon Data="{StaticResource Icon.Shield}" Size="16" Margin="0,0,12,0"/>
                                    <TextBlock Text="{DynamicResource Nav.Protect}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <!-- Sidebar Footer Status Card -->
                        <StackPanel Grid.Row="2">
                            <Border Background="#0A0A10" BorderBrush="#1C1B2C" BorderThickness="1"
                                    CornerRadius="10" Padding="12,10" Margin="12,8,12,14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource BrushSuccess}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="SmoothFrame Engine" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                    </StackPanel>
                                    <TextBlock Text="0.5 ms • ZGC Ready • Active" FontSize="10" Foreground="{StaticResource BrushTextMuted}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- = Content Pages = -->
                <Grid Grid.Column="1" x:Name="ContentHost">

                    <!-- ===== PAGE: OPTIMIZATION (MODULAR BENTO) ===== -->
                    <Grid x:Name="PageOpt">
                        <ScrollViewer Style="{StaticResource DarkScrollViewer}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="28,20,28,24">

                                <!-- Page Header with Global Hotkey hint -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{DynamicResource Opt.Title}" Style="{StaticResource TextTitle}"/>
                                        <TextBlock Text="{DynamicResource Opt.Subtitle}" Style="{StaticResource TextBody}" Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <!-- Quick Status / Hotkey Pill -->
                                    <Border Grid.Column="1" Background="#0C0D17" BorderBrush="#25223A" BorderThickness="1"
                                            CornerRadius="8" Padding="10,5" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource Header.HotkeyHint}" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,6,0"/>
                                            <Border Background="#1C1833" BorderBrush="#5B21B6" BorderThickness="1" CornerRadius="4" Padding="6,1">
                                                <TextBlock Text="Ctrl + Shift + B" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource BrushVioletText}"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Bento Full-Width Command Deck & System Metrics Card -->
                                <Border Style="{StaticResource HeroCard}" Padding="24,20" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Row 0: Status Header & Master Boost Button -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,18,0">
                                                <Border HorizontalAlignment="Left" CornerRadius="6" Padding="8,3" Margin="0,0,0,8">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource BrushNavActiveBg}"/>
                                                            <Setter Property="BorderBrush" Value="{StaticResource BrushBorderGlow}"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOptimizing}" Value="True">
                                                                    <Setter Property="Background" Value="#2D1117"/>
                                                                    <Setter Property="BorderBrush" Value="{StaticResource BrushDanger}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="{StaticResource BrushAccentHover}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsOptimizing}" Value="True">
                                                                            <Setter Property="Fill" Value="{StaticResource BrushDanger}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock FontSize="10.5" FontWeight="Bold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="{DynamicResource Hero.StandbyBadge}"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource BrushVioletText}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsOptimizing}" Value="True">
                                                                            <Setter Property="Text" Value="{DynamicResource Hero.ActiveBadge}"/>
                                                                            <Setter Property="Foreground" Value="{StaticResource BrushDanger}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>

                                                <TextBlock Text="{Binding StatusMessage}" FontSize="22" FontWeight="Bold"
                                                           Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding SubStatusMessage}" Style="{StaticResource TextBody}"/>
                                            </StackPanel>

                                            <Button Grid.Column="1" Style="{StaticResource HeroButton}"
                                                    Padding="28,15" VerticalAlignment="Center"
                                                    Command="{Binding ToggleOptimizationCommand}"
                                                    ToolTip="{DynamicResource Opt.Subtitle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <controls:AppIcon Data="{StaticResource Icon.PlayFill}" Filled="True" Size="14" Margin="0,0,8,0"
                                                                      Visibility="{Binding IsOptimizing, Converter={StaticResource InverseBoolToVisConverter}}"/>
                                                    <controls:AppIcon Data="{StaticResource Icon.Power}" Size="15" Margin="0,0,8,0"
                                                                      Visibility="{Binding IsOptimizing, Converter={StaticResource BoolToVisConverter}}"/>
                                                    <TextBlock Text="{Binding ActionButtonText}" FontSize="14" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <!-- Row 1: 4 System Metric Tiles (Spacious & Cleanly structured) -->
                                        <Grid Grid.Row="1" Margin="0,18,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Bento Tile 1: Timer -->
                                            <Border Grid.Column="0" Style="{StaticResource CardInset}" Padding="13,11" Margin="0,0,5,0"
                                                    ToolTip="{DynamicResource Card.Timer.Hint}">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                        <controls:AppIcon Data="{StaticResource Icon.Clock}" Size="13" Foreground="{StaticResource BrushAccentHover}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{DynamicResource Card.Timer.Label}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding TimerText}" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" Margin="0,0,0,2"/>
                                                    <TextBlock Text="{DynamicResource Card.Timer.Sub}" FontSize="10" Foreground="{StaticResource BrushTextMuted}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Bento Tile 2: Power Plan -->
                                            <Border Grid.Column="1" Style="{StaticResource CardInset}" Padding="13,11" Margin="3,0,3,0"
                                                    ToolTip="{DynamicResource Card.Power.Hint}">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                        <controls:AppIcon Data="{StaticResource Icon.Bolt}" Size="13" Foreground="#38BDF8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{DynamicResource Card.Power.Label}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding PowerPlanText}" FontSize="12.5" FontWeight="Bold" Foreground="#38BDF8" TextTrimming="CharacterEllipsis" Margin="0,0,0,2"/>
                                                    <TextBlock Text="{DynamicResource Card.Power.Sub}" FontSize="10" Foreground="{StaticResource BrushTextMuted}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Bento Tile 3: Priority -->
                                            <Border Grid.Column="2" Style="{StaticResource CardInset}" Padding="13,11" Margin="3,0,3,0"
                                                    ToolTip="{DynamicResource Card.Prio.Hint}">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                        <controls:AppIcon Data="{StaticResource Icon.Trend}" Size="13" Foreground="#FBBF24" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{DynamicResource Card.Prio.Label}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding PriorityText}" FontSize="12.5" FontWeight="Bold" Foreground="#FBBF24" TextTrimming="CharacterEllipsis" Margin="0,0,0,2"/>
                                                    <TextBlock Text="{DynamicResource Card.Prio.Sub}" FontSize="10" Foreground="{StaticResource BrushTextMuted}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Bento Tile 4: Protection -->
                                            <Border Grid.Column="3" Style="{StaticResource CardInset}" Padding="13,11" Margin="5,0,0,0"
                                                    ToolTip="{DynamicResource Hero.Protect}">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                        <controls:AppIcon Data="{StaticResource Icon.ShieldCheck}" Size="13" Foreground="{StaticResource BrushSuccess}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{DynamicResource Card.Prot.Label}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="Zero-Lag DPC" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource BrushSuccess}" Margin="0,0,0,2"/>
                                                    <TextBlock Text="{DynamicResource Card.Prot.Sub}" FontSize="10" Foreground="{StaticResource BrushTextMuted}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- Bento Full-Width Gaming Health & System Readiness Inspector Card (R4) -->
                                <Grid Margin="0,0,0,16">
                                    <!-- Sibling Shadow Layer (isolated from text to maintain 100% crisp ClearType subpixel rasterization) -->
                                    <Border Background="{StaticResource BrushBgCard}" CornerRadius="16" BorderBrush="#35265E" BorderThickness="1" Opacity="0.5">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#8B5CF6" BlurRadius="20" ShadowDepth="2" Opacity="0.25"/>
                                        </Border.Effect>
                                    </Border>

                                    <!-- Sharp Foreground Content Surface (no effects, crisp subpixel ClearType rendering) -->
                                    <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushTopHighlightBorder}" BorderThickness="1"
                                            CornerRadius="16" Padding="22,18" SnapsToDevicePixels="True" UseLayoutRounding="True"
                                            RenderOptions.ClearTypeHint="Enabled"
                                            TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
                                        <StackPanel>
                                            <!-- Card Header: Title + OS Version Text + Refresh Button -->
                                            <Grid Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,3">
                                                        <controls:AppIcon Data="{StaticResource Icon.ShieldCheck}" Size="16" Foreground="{StaticResource BrushAccentHover}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{DynamicResource Diag.Title}" Style="{StaticResource TextSection}" VerticalAlignment="Center"/>
                                                        <!-- Windows Version Tag Badge -->
                                                        <Border Background="#1C1833" BorderBrush="#5B21B6" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding WindowsVersionText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushVioletText}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{DynamicResource Diag.Subtitle}" Style="{StaticResource TextCaption}"/>
                                                </StackPanel>

                                                <!-- Refresh Diagnostics Button -->
                                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshDiagnosticsCommand}"
                                                        Padding="12,6" VerticalAlignment="Center" ToolTip="{DynamicResource Diag.RefreshBtn}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <controls:AppIcon Data="{StaticResource Icon.Refresh}" Size="12" Margin="0,0,6,0" Foreground="{StaticResource BrushAccentHover}"/>
                                                        <TextBlock Text="{DynamicResource Diag.RefreshBtn}" FontSize="11.5" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>

                                            <!-- 3 Diagnostics Status Bento Tiles -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Tile 1: VBS / Memory Integrity -->
                                                <Border Grid.Column="0" Style="{StaticResource CardInset}" Padding="14,12" Margin="0,0,6,0">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Header: Icon + Title + Status Badge -->
                                                        <Grid Grid.Row="0" Margin="0,0,0,6">
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                <controls:AppIcon Data="{StaticResource Icon.Shield}" Size="14" Foreground="#38BDF8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{DynamicResource Diag.Vbs.Title}" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <!-- Status Badge -->
                                                            <Border HorizontalAlignment="Right" CornerRadius="4" Padding="6,2">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="#2D1117"/>
                                                                        <Setter Property="BorderBrush" Value="{StaticResource BrushDanger}"/>
                                                                        <Setter Property="BorderThickness" Value="1"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsVbsActive}" Value="True">
                                                                                <Setter Property="Background" Value="#0D2E20"/>
                                                                                <Setter Property="BorderBrush" Value="{StaticResource BrushSuccess}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding VbsStatusText}" FontSize="10" FontWeight="Bold">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{StaticResource BrushDanger}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsVbsActive}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{StaticResource BrushSuccess}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                        </Grid>

                                                        <!-- Description -->
                                                        <TextBlock Grid.Row="1" Text="{DynamicResource Diag.Vbs.Desc}" FontSize="10.5" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,10" TextTrimming="CharacterEllipsis"/>

                                                        <!-- 1-Click Core Isolation Button -->
                                                        <Button Grid.Row="2" Style="{StaticResource SecondaryButton}" Command="{Binding OpenCoreIsolationCommand}"
                                                                Padding="0,6" HorizontalAlignment="Stretch" ToolTip="ms-settings:coreisolation">
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                <controls:AppIcon Data="{StaticResource Icon.Settings}" Size="12" Margin="0,0,6,0" Foreground="{StaticResource BrushAccentHover}"/>
                                                                <TextBlock Text="{DynamicResource Diag.Vbs.Btn}" FontSize="11" FontWeight="SemiBold"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>
                                                </Border>

                                                <!-- Tile 2: HAGS (Hardware Accelerated GPU Scheduling) -->
                                                <Border Grid.Column="1" Style="{StaticResource CardInset}" Padding="14,12" Margin="3,0,3,0">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Header: Icon + Title + Status Badge -->
                                                        <Grid Grid.Row="0" Margin="0,0,0,6">
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                <controls:AppIcon Data="{StaticResource Icon.Gauge}" Size="14" Foreground="{StaticResource BrushAccentHover}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{DynamicResource Diag.Hags.Title}" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <!-- Status Badge -->
                                                            <Border HorizontalAlignment="Right" CornerRadius="4" Padding="6,2">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="#2D1117"/>
                                                                        <Setter Property="BorderBrush" Value="{StaticResource BrushDanger}"/>
                                                                        <Setter Property="BorderThickness" Value="1"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsHagsActive}" Value="True">
                                                                                <Setter Property="Background" Value="#0D2E20"/>
                                                                                <Setter Property="BorderBrush" Value="{StaticResource BrushSuccess}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding HagsStatusText}" FontSize="10" FontWeight="Bold">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{StaticResource BrushDanger}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsHagsActive}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{StaticResource BrushSuccess}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                        </Grid>

                                                        <!-- Description -->
                                                        <TextBlock Grid.Row="1" Text="{DynamicResource Diag.Hags.Desc}" FontSize="10.5" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,10" TextTrimming="CharacterEllipsis"/>

                                                        <!-- Readiness Indicator Badge -->
                                                        <Border Grid.Row="2" Background="#14111E" BorderBrush="#2A2246" BorderThickness="1" CornerRadius="6" Padding="8,6" HorizontalAlignment="Stretch">
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                    <Ellipse.Style>
                                                                        <Style TargetType="Ellipse">
                                                                            <Setter Property="Fill" Value="{StaticResource BrushDanger}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsHagsActive}" Value="True">
                                                                                    <Setter Property="Fill" Value="{StaticResource BrushSuccess}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Ellipse.Style>
                                                                </Ellipse>
                                                                <TextBlock FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="WDDM 2.7+ GPU Scheduling"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsHagsActive}" Value="True">
                                                                                    <Setter Property="Text" Value="HwSchMode = 2 (Hardware Scheduling Active)"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <!-- Tile 3: Windows Game Mode -->
                                                <Border Grid.Column="2" Style="{StaticResource CardInset}" Padding="14,12" Margin="6,0,0,0">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Header: Icon + Title + Status Badge -->
                                                        <Grid Grid.Row="0" Margin="0,0,0,6">
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                <controls:AppIcon Data="{StaticResource Icon.Game}" Size="14" Foreground="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{DynamicResource Diag.GameMode.Title}" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            </StackPanel>
                                                            <!-- Status Badge -->
                                                            <Border HorizontalAlignment="Right" CornerRadius="4" Padding="6,2">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="#2D1117"/>
                                                                        <Setter Property="BorderBrush" Value="{StaticResource BrushDanger}"/>
                                                                        <Setter Property="BorderThickness" Value="1"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsGameModeActive}" Value="True">
                                                                                <Setter Property="Background" Value="#0D2E20"/>
                                                                                <Setter Property="BorderBrush" Value="{StaticResource BrushSuccess}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding GameModeStatusText}" FontSize="10" FontWeight="Bold">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{StaticResource BrushDanger}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsGameModeActive}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{StaticResource BrushSuccess}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                        </Grid>

                                                        <!-- Description -->
                                                        <TextBlock Grid.Row="1" Text="{DynamicResource Diag.GameMode.Desc}" FontSize="10.5" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,10" TextTrimming="CharacterEllipsis"/>

                                                        <!-- Readiness Indicator Badge -->
                                                        <Border Grid.Row="2" Background="#14111E" BorderBrush="#2A2246" BorderThickness="1" CornerRadius="6" Padding="8,6" HorizontalAlignment="Stretch">
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                    <Ellipse.Style>
                                                                        <Style TargetType="Ellipse">
                                                                            <Setter Property="Fill" Value="{StaticResource BrushDanger}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsGameModeActive}" Value="True">
                                                                                    <Setter Property="Fill" Value="{StaticResource BrushSuccess}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Ellipse.Style>
                                                                </Ellipse>
                                                                <TextBlock FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="AutoGameMode Tuning"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsGameModeActive}" Value="True">
                                                                                    <Setter Property="Text" Value="Windows Game Priority Engaged"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Bento Row 2: Split Command Deck (Games Library on Left + Quick Controls on Right) -->
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="360"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- LEFT COLUMN: Game Library -->
                                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20" Margin="0,0,10,0">
                                        <DockPanel LastChildFill="True">
                                            <!-- Library Header -->
                                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <controls:AppIcon Data="{StaticResource Icon.Game}" Size="16" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{DynamicResource Lib.Title}" Style="{StaticResource TextSection}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding AddCustomGameCommand}" Margin="0,0,8,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <controls:AppIcon Data="{StaticResource Icon.Plus}" Size="12" Margin="0,0,6,0"/>
                                                            <TextBlock Text="{DynamicResource Btn.AddGame}" FontSize="12"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshGamesCommand}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <controls:AppIcon Data="{StaticResource Icon.Refresh}" Size="12" Margin="0,0,6,0"/>
                                                            <TextBlock Text="{DynamicResource Btn.Refresh}" FontSize="12"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Library Subtitle / Quick explanation -->
                                            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Lib.Desc}"
                                                       FontSize="11.5" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,12"/>

                                            <!-- Empty state indicator -->
                                            <TextBlock DockPanel.Dock="Bottom" Text="{DynamicResource Lib.Empty}" Style="{StaticResource EmptyHint}"/>

                                            <!-- Games Grid -->
                                            <ListBox x:Name="GamesList"
                                                     ItemsSource="{Binding Games}"
                                                     SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     ItemContainerStyle="{StaticResource GameCardItem}"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                     MinHeight="220">
                                                <ListBox.InputBindings>
                                                    <KeyBinding Key="Delete" Command="{Binding RemoveCustomGameCommand}" CommandParameter="{Binding SelectedGame}"/>
                                                </ListBox.InputBindings>
                                                <ListBox.Resources>
                                                    <Style TargetType="ScrollViewer" BasedOn="{StaticResource DarkScrollViewer}"/>
                                                </ListBox.Resources>
                                                <ListBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ListBox.ItemsPanel>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                                            <Grid.ContextMenu>
                                                                <ContextMenu Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorderStrong}" BorderThickness="1">
                                                                    <MenuItem Header="{DynamicResource VM.Msg.RemoveTitle}"
                                                                              Foreground="{StaticResource BrushTextPrimary}"
                                                                              Command="{Binding PlacementTarget.Tag.RemoveCustomGameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                                        <MenuItem.Style>
                                                                            <Style TargetType="MenuItem">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Source}" Value="Custom">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </Style>
                                                                        </MenuItem.Style>
                                                                    </MenuItem>
                                                                </ContextMenu>
                                                            </Grid.ContextMenu>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="#12111E" BorderBrush="#25233D" BorderThickness="1" VerticalAlignment="Center">
                                                                <Image Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Source="{Binding IconBase64, Converter={StaticResource Base64ToImageConverter}}"/>
                                                            </Border>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                                                <TextBlock Text="{Binding Name}"
                                                                           Foreground="#FFFFFF"
                                                                           FontSize="12.5" FontWeight="Bold"
                                                                           TextTrimming="CharacterEllipsis" MaxWidth="135"/>
                                                                <Border Background="#241448" BorderBrush="#8B5CF6" BorderThickness="1"
                                                                        CornerRadius="4" Padding="6,1" HorizontalAlignment="Left" Margin="0,5,0,0">
                                                                    <TextBlock Text="{Binding Source}" FontSize="9.5" FontWeight="Bold"
                                                                               Foreground="{StaticResource BrushVioletText}"/>
                                                                </Border>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </DockPanel>
                                    </Border>

                                    <!-- RIGHT COLUMN: Quick Acceleration Controls -->
                                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20" Margin="6,0,0,0">
                                        <StackPanel>
                                            <!-- Controls Header -->
                                            <Grid Margin="0,0,0,6">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <controls:AppIcon Data="{StaticResource Icon.Bolt}" Size="15" Foreground="{StaticResource BrushAccentHover}" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{DynamicResource Deck.QuickTitle}" Style="{StaticResource TextSection}"/>
                                                </StackPanel>
                                                <Border HorizontalAlignment="Right" Background="#1E1436" BorderBrush="#6D28D9" BorderThickness="1" CornerRadius="5" Padding="7,2">
                                                    <TextBlock Text="{DynamicResource Deck.QuickBadge}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushVioletText}"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{DynamicResource Deck.QuickDesc}" FontSize="11.5" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,16"/>

                                            <!-- Toggle 1: Auto-boost on game launch -->
                                            <Border Style="{StaticResource CardInset}" Padding="12,10" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <TextBlock Text="{DynamicResource Deck.AutoBoost.Title}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                        <TextBlock Text="{DynamicResource Deck.AutoBoost.Desc}" FontSize="10.5" Foreground="{StaticResource BrushTextMuted}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="1" Style="{StaticResource SwitchStyle}" IsChecked="{Binding AutoBoostOnGameLaunch, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>

                                            <!-- Toggle 2: Isolate P-Cores -->
                                            <Border Style="{StaticResource CardInset}" Padding="12,10" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <TextBlock Text="{DynamicResource Deck.PCores.Title}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                        <TextBlock Text="{DynamicResource Deck.PCores.Desc}" FontSize="10.5" Foreground="{StaticResource BrushTextMuted}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="1" Style="{StaticResource SwitchStyle}" IsChecked="{Binding IsolatePCores, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>

                                            <!-- Toggle 3: Deprioritize Background -->
                                            <Border Style="{StaticResource CardInset}" Padding="12,10" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <TextBlock Text="{DynamicResource Deck.Bg.Title}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                        <TextBlock Text="{DynamicResource Deck.Bg.Desc}" FontSize="10.5" Foreground="{StaticResource BrushTextMuted}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="1" Style="{StaticResource SwitchStyle}" IsChecked="{Binding DeprioritizeBackground, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>

                                            <!-- Toggle 4: Low-Latency Network (Zero-Ping) -->
                                            <Border Style="{StaticResource CardInset}" Padding="12,10" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <TextBlock Text="{DynamicResource Deck.Network.Title}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                        <TextBlock Text="{DynamicResource Deck.Network.Desc}" FontSize="10.5" Foreground="{StaticResource BrushTextMuted}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="1" Style="{StaticResource SwitchStyle}" IsChecked="{Binding OptimizeNetwork, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>

                                            <!-- Toggle 5: Disk I/O Acceleration -->
                                            <Border Style="{StaticResource CardInset}" Padding="12,10" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <TextBlock Text="{DynamicResource Deck.Io.Title}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                        <TextBlock Text="{DynamicResource Deck.Io.Desc}" FontSize="10.5" Foreground="{StaticResource BrushTextMuted}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="1" Style="{StaticResource SwitchStyle}" IsChecked="{Binding OptimizeIoPriority, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>

                                            <!-- Toggle 6: Process QoS & Power Throttling (R1) -->
                                            <Border Style="{StaticResource CardInset}" Padding="12,10" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <TextBlock Text="{DynamicResource Deck.Qos.Title}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                        <TextBlock Text="{DynamicResource Deck.Qos.Desc}" FontSize="10.5" Foreground="{StaticResource BrushTextMuted}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="1" Style="{StaticResource SwitchStyle}" IsChecked="{Binding ProcessQosEnabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>

                                            <!-- Toggle 7: Windowed Game Optimization (R2) -->
                                            <Border Style="{StaticResource CardInset}" Padding="12,10" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <TextBlock Text="{DynamicResource Deck.WinGame.Title}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                        <TextBlock Text="{DynamicResource Deck.WinGame.Desc}" FontSize="10.5" Foreground="{StaticResource BrushTextMuted}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="1" Style="{StaticResource SwitchStyle}" IsChecked="{Binding WindowedGameOptimization, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>

                                            <!-- Toggle 8: 1:1 Linear Hardware Mouse Input (R3) -->
                                            <Border Style="{StaticResource CardInset}" Padding="12,10" Margin="0,0,0,14">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <TextBlock Text="{DynamicResource Deck.Mouse.Title}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                        <TextBlock Text="{DynamicResource Deck.Mouse.Desc}" FontSize="10.5" Foreground="{StaticResource BrushTextMuted}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="1" Style="{StaticResource SwitchStyle}" IsChecked="{Binding LinearMouseInput, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>

                                            <!-- Quick Action 1: Standby RAM Purge -->
                                            <Border Style="{StaticResource CardInset}" Padding="14,12" Background="#14111E" BorderBrush="#2A2246" BorderThickness="1">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,6">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <controls:AppIcon Data="{StaticResource Icon.Activity}" Size="13" Foreground="#38BDF8" Margin="0,0,6,0"/>
                                                            <TextBlock Text="{DynamicResource Deck.Ram.Title}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <TextBlock Text="{DynamicResource Deck.Ram.Desc}" FontSize="10.5" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding PurgeStandbyMemoryCommand}" HorizontalAlignment="Stretch" Padding="0,8">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <controls:AppIcon Data="{StaticResource Icon.Refresh}" Size="12" Margin="0,0,6,0" Foreground="{StaticResource BrushAccentHover}"/>
                                                            <TextBlock Text="{DynamicResource Deck.Ram.Btn}" FontSize="11.5" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Border>

                                            <!-- Quick Action 2: DirectX / GPU Shader Cache Purge -->
                                            <Border Style="{StaticResource CardInset}" Padding="14,12" Background="#14111E" BorderBrush="#2A2246" BorderThickness="1" Margin="0,8,0,0">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,6">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <controls:AppIcon Data="{StaticResource Icon.Trash}" Size="13" Foreground="#A855F7" Margin="0,0,6,0"/>
                                                            <TextBlock Text="{DynamicResource Deck.Shaders.Title}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <TextBlock Text="{DynamicResource Deck.Shaders.Desc}" FontSize="10.5" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding ClearShaderCacheCommand}" HorizontalAlignment="Stretch" Padding="0,8">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <controls:AppIcon Data="{StaticResource Icon.Refresh}" Size="12" Margin="0,0,6,0" Foreground="{StaticResource BrushAccentHover}"/>
                                                            <TextBlock Text="{DynamicResource Deck.Shaders.Btn}" FontSize="11.5" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ===== PAGE: MINECRAFT PRO BOOSTER (MODULAR BENTO) ===== -->
                    <Grid x:Name="PageMinecraft" Visibility="Collapsed">
                        <ScrollViewer Style="{StaticResource DarkScrollViewer}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="28,22,28,26">
                                <!-- Page Header with Engine Badge Pill -->
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{DynamicResource Mc.Title}" Style="{StaticResource TextTitle}"/>
                                        <TextBlock Text="{DynamicResource Mc.Subtitle}" Style="{StaticResource TextBody}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <!-- Version & Engine Badge Pill -->
                                    <Border Grid.Column="1" Background="#0C0D17" BorderBrush="#25223A" BorderThickness="1"
                                            CornerRadius="8" Padding="10,5" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="NeoForge 1.21+" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,6,0"/>
                                            <Border Background="#1C1833" BorderBrush="#5B21B6" BorderThickness="1" CornerRadius="4" Padding="6,1">
                                                <TextBlock Text="Java 21 • ZGC" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource BrushVioletText}"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Bento Module 1: Live Telemetry & Master HUD (Top Wide Bento Tile) -->
                                <Border Style="{StaticResource HeroCard}" Margin="0,0,0,16" Padding="24,20"
                                        Background="{StaticResource BrushMinecraftHeroBg}" BorderBrush="{StaticResource BrushBorderGlow}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Top Row: Master Toggle & Status -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <!-- Live pulsing status badge -->
                                                <Border HorizontalAlignment="Left" CornerRadius="6" Padding="8,3" Margin="0,0,0,8">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource BrushNavActiveBg}"/>
                                                            <Setter Property="BorderBrush" Value="{StaticResource BrushBorderGlow}"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMinecraftOptimizing}" Value="True">
                                                                    <Setter Property="Background" Value="#2D1117"/>
                                                                    <Setter Property="BorderBrush" Value="{StaticResource BrushDanger}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="{StaticResource BrushTextMuted}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsMinecraftOptimizing}" Value="True">
                                                                            <Setter Property="Fill" Value="{StaticResource BrushDanger}"/>
                                                                            <DataTrigger.EnterActions>
                                                                                <BeginStoryboard x:Name="PulseStoryboard">
                                                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                                         From="1.0" To="0.25" Duration="0:0:0.8"/>
                                                                                    </Storyboard>
                                                                                </BeginStoryboard>
                                                                            </DataTrigger.EnterActions>
                                                                            <DataTrigger.ExitActions>
                                                                                <StopStoryboard BeginStoryboardName="PulseStoryboard"/>
                                                                            </DataTrigger.ExitActions>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock Text="{Binding MinecraftHeroBadgeText}" FontSize="10.5" FontWeight="Bold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource BrushVioletText}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsMinecraftOptimizing}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource BrushDanger}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>

                                                <TextBlock Text="{Binding MinecraftHeroStatusTitle}" FontSize="22" FontWeight="Bold"
                                                           Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding MinecraftHeroStatusSubtitle}" Style="{StaticResource TextBody}"/>

                                                <!-- Live technical status banner when active -->
                                                <Border Background="#150E28" BorderBrush="{StaticResource BrushBorderGlow}"
                                                        BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,10,0,0"
                                                        Visibility="{Binding IsMinecraftOptimizing, Converter={StaticResource BoolToVisConverter}}">
                                                    <TextBlock Text="{DynamicResource Mc.Hero.SubtitleActive}"
                                                               Foreground="{StaticResource BrushVioletText}" FontSize="11" FontWeight="SemiBold"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- Prominent Master Boost Button -->
                                            <Button Grid.Column="1" Style="{StaticResource MinecraftHeroButton}"
                                                    Padding="28,15" VerticalAlignment="Center" Margin="14,0,0,0"
                                                    Command="{Binding ToggleMinecraftOptimizationCommand}">
                                                <StackPanel Orientation="Horizontal">
                                                    <controls:AppIcon Data="{StaticResource Icon.BoltFill}" Filled="True" Size="14" Margin="0,0,8,0"
                                                                      Visibility="{Binding IsMinecraftOptimizing, Converter={StaticResource InverseBoolToVisConverter}}"/>
                                                    <controls:AppIcon Data="{StaticResource Icon.Power}" Size="15" Margin="0,0,8,0"
                                                                      Visibility="{Binding IsMinecraftOptimizing, Converter={StaticResource BoolToVisConverter}}"/>
                                                    <TextBlock Text="{Binding MinecraftActionButtonText}" FontSize="14" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <!-- Row 1: Intelligent Telemetry Zone -->
                                        <!-- State A: Live in-game telemetry gauges (shown when Minecraft mod is connected) -->
                                        <Grid Grid.Row="1" Margin="0,18,0,0"
                                              Visibility="{Binding IsModActiveInGame, Converter={StaticResource BoolToVisConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Metric 1: Current FPS -->
                                            <Border Grid.Column="0" Style="{StaticResource CardInset}" Padding="16,14" Margin="0,0,6,0"
                                                    Background="#0D0D14" BorderBrush="#201E35" BorderThickness="1">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,6">
                                                        <TextBlock Text="{DynamicResource Mc.Hud.Fps}" Style="{StaticResource TextCaption}" FontWeight="Bold"/>
                                                        <controls:AppIcon Data="{StaticResource Icon.Activity}" Size="14" Foreground="{StaticResource BrushAccentHover}" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                                        <TextBlock Text="{Binding InGameFps}" FontSize="32" FontWeight="Bold"
                                                                   Foreground="{StaticResource BrushAccentHover}" FontFamily="Segoe UI"/>
                                                        <TextBlock Text=" FPS" Style="{StaticResource TextCaption}" Margin="6,0,0,6" VerticalAlignment="Bottom" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                    <Border Height="2" Background="{StaticResource BrushAccentGradient}" Margin="0,8,0,0" CornerRadius="1"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Metric 2: 1% Low FPS -->
                                            <Border Grid.Column="1" Style="{StaticResource CardInset}" Padding="16,14" Margin="3,0,3,0"
                                                    Background="#0D0D14" BorderBrush="#201E35" BorderThickness="1">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,6">
                                                        <TextBlock Text="{DynamicResource Mc.Hud.OnePercentLow}" Style="{StaticResource TextCaption}" FontWeight="Bold"/>
                                                        <controls:AppIcon Data="{StaticResource Icon.Trend}" Size="14" Foreground="{StaticResource BrushSuccess}" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                                        <TextBlock Text="{Binding InGameOnePercentLow}" FontSize="32" FontWeight="Bold"
                                                                   Foreground="{StaticResource BrushSuccess}" FontFamily="Segoe UI"/>
                                                        <TextBlock Text=" FPS" Style="{StaticResource TextCaption}" Margin="6,0,0,6" VerticalAlignment="Bottom" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                    <Border Height="2" Background="{StaticResource BrushSuccess}" Margin="0,8,0,0" CornerRadius="1"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Metric 3: Frametime (ms) -->
                                            <Border Grid.Column="2" Style="{StaticResource CardInset}" Padding="16,14" Margin="6,0,0,0"
                                                    Background="#0D0D14" BorderBrush="#201E35" BorderThickness="1">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,6">
                                                        <TextBlock Text="{DynamicResource Mc.Hud.Frametime}" Style="{StaticResource TextCaption}" FontWeight="Bold"/>
                                                        <controls:AppIcon Data="{StaticResource Icon.Clock}" Size="14" Foreground="{StaticResource BrushWarning}" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                                        <TextBlock Text="{Binding InGameFrametimeMs, StringFormat='{}{0:F1}'}" FontSize="32" FontWeight="Bold"
                                                                   Foreground="#FFFFFF" FontFamily="Segoe UI"/>
                                                        <TextBlock Text=" ms" Style="{StaticResource TextCaption}" Margin="6,0,0,6" VerticalAlignment="Bottom" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                    <Border Height="2" Background="{StaticResource BrushWarning}" Margin="0,8,0,0" CornerRadius="1"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- State B: Smart Standby Banner (shown when Minecraft is not running) -->
                                        <Border Grid.Row="1" Margin="0,16,0,0" Style="{StaticResource CardInset}" Padding="15,11"
                                                Visibility="{Binding IsModActiveInGame, Converter={StaticResource InverseBoolToVisConverter}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#16122C" BorderBrush="#2F2554" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <controls:AppIcon Data="{StaticResource Icon.Activity}" Size="16" Foreground="{StaticResource BrushAccentHover}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource Mc.Hud.Title}" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                    <TextBlock Text="{DynamicResource Mc.Hud.WaitingBanner}" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="6" Padding="10,4" Background="#161426" BorderBrush="#2C2746" BorderThickness="1">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="6" Height="6" Fill="{StaticResource BrushTextMuted}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{DynamicResource Mc.Hud.BadgeWaiting}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Bento 2x2 Grid: Preparation Deck on Left + Hardware & RAM on Right -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- ================= LEFT COLUMN ================= -->
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">

                                        <!-- Tile A: Launcher & Environment -->
                                        <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <controls:AppIcon Data="{StaticResource Icon.Game}" Size="15" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,7,0"/>
                                                            <TextBlock Text="{DynamicResource Mc.Launcher.Title}" Style="{StaticResource TextSection}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{DynamicResource Mc.Launcher.Subtitle}" Style="{StaticResource TextCaption}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshMinecraftCommand}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <controls:AppIcon Data="{StaticResource Icon.Refresh}" Size="12" Margin="0,0,6,0"/>
                                                            <TextBlock Text="{DynamicResource Btn.Refresh}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>

                                                <ComboBox Style="{StaticResource DarkComboBox}"
                                                          ItemsSource="{Binding MinecraftLaunchers}"
                                                          SelectedItem="{Binding SelectedMinecraftLauncher, Mode=TwoWay}"
                                                          DisplayMemberPath="Name" Margin="0,0,0,10"/>

                                                <Grid Margin="0,0,0,14" Visibility="{Binding HasSelectedLauncher, Converter={StaticResource BoolToVisConverter}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="{StaticResource BrushAccentSoft}" BorderBrush="{StaticResource BrushBorderGlow}" BorderThickness="1"
                                                            CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding SelectedMinecraftLauncher.ActiveVersionName, FallbackValue='NeoForge 1.21.1'}"
                                                                   Foreground="{StaticResource BrushVioletText}" FontWeight="SemiBold" FontSize="11.5"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="Java 21 / Generational ZGC Ready" Style="{StaticResource TextCaption}" VerticalAlignment="Center"/>
                                                </Grid>

                                                <!-- 1-Click Apply to Launcher Action -->
                                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding ApplyMinecraftCommand}"
                                                        HorizontalAlignment="Stretch" Padding="0,9" Margin="0,0,0,8">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <controls:AppIcon Data="{StaticResource Icon.BoltFill}" Size="12" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{DynamicResource Mc.Btn.Apply}" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Button>

                                                <!-- Secondary Tools Row -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Style="{StaticResource SecondaryButton}" Command="{Binding CopyJvmArgsCommand}" Margin="0,0,4,0" Padding="0,7">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <controls:AppIcon Data="{StaticResource Icon.Check}" Size="11" Margin="0,0,5,0"/>
                                                            <TextBlock Text="{DynamicResource Mc.Btn.CopyArgs}" FontSize="11.5"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Command="{Binding RollbackMinecraftCommand}" Margin="4,0,0,0" Padding="0,7">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <controls:AppIcon Data="{StaticResource Icon.Restore}" Size="11" Margin="0,0,5,0"/>
                                                            <TextBlock Text="{DynamicResource Mc.Btn.Rollback}" FontSize="11.5"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Tile B: SmoothFrame In-Game Mod & HUD -->
                                        <Border Style="{StaticResource Card}" Padding="20">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <controls:AppIcon Data="{StaticResource Icon.Bolt}" Size="15" Foreground="{StaticResource BrushAccentHover}" Margin="0,0,7,0"/>
                                                            <TextBlock Text="{DynamicResource Mc.Mod.Title}" Style="{StaticResource TextSection}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{DynamicResource Mc.Mod.Desc}" Style="{StaticResource TextCaption}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="6" Padding="8,3" BorderThickness="1">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{StaticResource BrushBgInset}"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrong}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSmoothFrameModInstalled}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource BrushSuccessTint}"/>
                                                                        <Setter Property="BorderBrush" Value="{StaticResource BrushSuccess}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                <Ellipse.Style>
                                                                    <Style TargetType="Ellipse">
                                                                        <Setter Property="Fill" Value="{StaticResource BrushTextMuted}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSmoothFrameModInstalled}" Value="True">
                                                                                <Setter Property="Fill" Value="{StaticResource BrushSuccess}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Ellipse.Style>
                                                            </Ellipse>
                                                            <TextBlock Text="{Binding SmoothFrameModStatusText}" FontSize="10.5" FontWeight="Bold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSmoothFrameModInstalled}" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource BrushSuccess}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>

                                                <!-- Features Checklist -->
                                                <StackPanel Margin="0,0,0,12">
                                                    <TextBlock Text="{DynamicResource Mc.Mod.Feature1}" Style="{StaticResource TextCaption}" Margin="0,0,0,3"/>
                                                    <TextBlock Text="{DynamicResource Mc.Mod.Feature2}" Style="{StaticResource TextCaption}" Margin="0,0,0,3"/>
                                                    <TextBlock Text="{DynamicResource Mc.Mod.Feature3}" Style="{StaticResource TextCaption}"/>
                                                </StackPanel>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Style="{StaticResource PrimaryButton}" Command="{Binding InstallSmoothFrameModCommand}" Margin="0,0,4,0" Padding="0,8">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <controls:AppIcon Data="{StaticResource Icon.BoltFill}" Size="12" Margin="0,0,6,0"/>
                                                            <TextBlock Text="{DynamicResource Mc.Mod.InstallBtn}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Command="{Binding UninstallSmoothFrameModCommand}" Margin="4,0,0,0" Padding="0,8">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <controls:AppIcon Data="{StaticResource Icon.Restore}" Size="12" Margin="0,0,6,0"/>
                                                            <TextBlock Text="{DynamicResource Mc.Mod.UninstallBtn}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- ================= RIGHT COLUMN ================= -->
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">

                                        <!-- Tile C: RAM Allocation & Garbage Collector (JVM) -->
                                        <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <controls:AppIcon Data="{StaticResource Icon.Trend}" Size="15" Foreground="#FBBF24" Margin="0,0,7,0"/>
                                                        <TextBlock Text="{DynamicResource Mc.Ram.Title}" Style="{StaticResource TextSection}"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="{StaticResource BrushNavActiveBg}" BorderBrush="{StaticResource BrushBorderGlow}"
                                                            BorderThickness="1" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding MinecraftRamGbText}" FontWeight="Bold"
                                                                   FontSize="12.5" Foreground="{StaticResource BrushVioletText}"/>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{DynamicResource Mc.Ram.Desc}" Style="{StaticResource TextCaption}" Margin="0,0,0,10"/>

                                                <Slider Style="{StaticResource DarkSlider}"
                                                        Minimum="{Binding MinRamMb}" Maximum="{Binding MaxRamMb}"
                                                        Value="{Binding MinecraftRamMb, Mode=TwoWay}"
                                                        SmallChange="512" LargeChange="1024"
                                                        TickFrequency="1024" IsSnapToTickEnabled="True"
                                                        Margin="0,0,0,8"/>

                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{DynamicResource Mc.Ram.Min}" Style="{StaticResource TextCaption}"/>
                                                    <Border Grid.Column="1" HorizontalAlignment="Center" Background="#16122C" CornerRadius="4" Padding="6,1">
                                                        <TextBlock Text="{DynamicResource Mc.Ram.Optimum}" FontSize="10.5" Foreground="{StaticResource BrushVioletText}" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="2" Text="{DynamicResource Mc.Ram.Max}" Style="{StaticResource TextCaption}"/>
                                                </Grid>

                                                <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,0,0,10"/>

                                                <TextBlock Text="{DynamicResource Mc.Gc.Title}" Style="{StaticResource TextSection}" FontSize="13" Margin="0,0,0,6"/>
                                                <StackPanel>
                                                    <RadioButton GroupName="GcProfile" Style="{StaticResource DarkRadioButton}"
                                                                 Content="{DynamicResource Mc.Gc.Zgc}"
                                                                 IsChecked="{Binding IsZgcSelected, Mode=TwoWay}" Margin="0,0,0,5"/>
                                                    <RadioButton GroupName="GcProfile" Style="{StaticResource DarkRadioButton}"
                                                                 Content="{DynamicResource Mc.Gc.G1gc}"
                                                                 IsChecked="{Binding IsG1gcSelected, Mode=TwoWay}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Tile D: Hardware & OS Optimizations -->
                                        <Border Style="{StaticResource Card}" Padding="20">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                                    <controls:AppIcon Data="{StaticResource Icon.Gauge}" Size="15" Foreground="#38BDF8" Margin="0,0,7,0"/>
                                                    <TextBlock Text="{DynamicResource Mc.Gpu.Title}" Style="{StaticResource TextSection}"/>
                                                </StackPanel>
                                                <TextBlock Text="{DynamicResource Mc.Gpu.Desc}" Style="{StaticResource TextCaption}" Margin="0,0,0,12"/>

                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Style="{StaticResource SecondaryButton}" Command="{Binding ForceGpuCommand}" Margin="0,0,4,0" Padding="0,8">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <controls:AppIcon Data="{StaticResource Icon.Gauge}" Size="12" Margin="0,0,6,0"/>
                                                            <TextBlock Text="{DynamicResource Mc.Btn.Gpu}" FontSize="11.5"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Command="{Binding PurgeStandbyMemoryCommand}" Margin="4,0,0,0" Padding="0,8">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <controls:AppIcon Data="{StaticResource Icon.Restore}" Size="12" Margin="0,0,6,0"/>
                                                            <TextBlock Text="{DynamicResource Mc.Btn.PurgeMem}" FontSize="11.5"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>

                                                <!-- Status notification banner -->
                                                <Border Background="#150E28" BorderBrush="{StaticResource BrushBorderGlow}"
                                                        BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,4,0,0"
                                                        Visibility="{Binding HasMinecraftStatus, Converter={StaticResource BoolToVisConverter}}">
                                                    <TextBlock Text="{Binding MinecraftStatusMessage}" Foreground="{StaticResource BrushVioletText}" FontSize="11.5"/>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Bento Module 3: Built-in Technologies SmoothFrame (All-In-One Bento Grid) -->
                                <Border Style="{StaticResource Card}" Padding="20">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <controls:AppIcon Data="{StaticResource Icon.ShieldCheck}" Size="15" Foreground="{StaticResource BrushSuccess}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{DynamicResource Mc.Mods.Title}" Style="{StaticResource TextSection}"/>
                                            </StackPanel>
                                            <Border HorizontalAlignment="Right" Background="#112217" BorderBrush="{StaticResource BrushSuccess}" BorderThickness="1" CornerRadius="5" Padding="7,2">
                                                <TextBlock Text="АКТИВНО В ФОНЕ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushSuccess}"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{DynamicResource Mc.Aio.Subtitle}" Style="{StaticResource TextCaption}" Margin="0,0,0,12"/>

                                        <ItemsControl ItemsSource="{Binding BuiltinTechnologies}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="2"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource CardInset}" Padding="12,9" Margin="4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Background="{StaticResource BrushAccentSoft}" BorderBrush="{StaticResource BrushBorderGlow}" BorderThickness="1" CornerRadius="4" Padding="5,2" Margin="0,0,9,0" VerticalAlignment="Top">
                                                                <TextBlock Text="{DynamicResource Mc.Aio.Badge}" Foreground="{StaticResource BrushVioletText}" FontSize="9.5" FontWeight="Bold"/>
                                                            </Border>
                                                            <StackPanel Grid.Column="1">
                                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource BrushTextPrimary}"/>
                                                                    <TextBlock Text="{Binding Category, StringFormat=' ({0})'}" Style="{StaticResource TextCaption}" FontSize="10.5"/>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Description}" Style="{StaticResource TextCaption}" FontSize="10.5" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ===== PAGE: SETTINGS ===== -->
                    <Grid x:Name="PageSettings" Visibility="Collapsed">
                        <ScrollViewer Style="{StaticResource DarkScrollViewer}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="28,22,28,32" MaxWidth="960" HorizontalAlignment="Stretch">
                                <TextBlock Text="{DynamicResource Sett.Title}" Style="{StaticResource TextTitle}"/>
                                <TextBlock Text="{DynamicResource Sett.Subtitle}" Style="{StaticResource TextBody}" Margin="0,4,0,22"/>

                                <!-- SECTION 1: HARDWARE CORE & OS -->
                                <StackPanel Margin="2,0,0,10">
                                    <TextBlock Text="{DynamicResource Set.Group.Core}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}"/>
                                    <TextBlock Text="{DynamicResource Set.Group.CoreDesc}" FontSize="11.5" Foreground="{StaticResource BrushTextMuted}" Opacity="0.7" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border Style="{StaticResource Card}" CornerRadius="14" Margin="0,0,0,20" Padding="4,4">
                                    <StackPanel>
                                        <!-- Row 1: High Precision Timer -->
                                        <Grid Margin="16,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" 
                                                    Background="{StaticResource BrushAccentSoft}" 
                                                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                                    Margin="0,0,14,0" VerticalAlignment="Center">
                                                <controls:AppIcon Data="{StaticResource Icon.Clock}" Size="17"
                                                                  Foreground="{StaticResource BrushAccentHover}"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{DynamicResource Set.Timer.Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                                <TextBlock Text="{DynamicResource Set.Timer.Desc}" Style="{StaticResource TextBody}" FontSize="11.5" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="2" Style="{StaticResource SwitchStyle}" IsChecked="{Binding HighPrecisionTimer, Mode=TwoWay}" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Border Height="1" Background="{StaticResource BrushBorder}" Margin="66,0,16,0" Opacity="0.5"/>

                                        <!-- Row 2: High Performance Plan -->
                                        <Grid Margin="16,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" 
                                                    Background="{StaticResource BrushAccentSoft}" 
                                                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                                    Margin="0,0,14,0" VerticalAlignment="Center">
                                                <controls:AppIcon Data="{StaticResource Icon.Bolt}" Size="17"
                                                                  Foreground="{StaticResource BrushAccentHover}"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{DynamicResource Set.Power.Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                                <TextBlock Text="{DynamicResource Set.Power.Desc}" Style="{StaticResource TextBody}" FontSize="11.5" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="2" Style="{StaticResource SwitchStyle}" IsChecked="{Binding HighPerformancePlan, Mode=TwoWay}" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Border Height="1" Background="{StaticResource BrushBorder}" Margin="66,0,16,0" Opacity="0.5"/>

                                        <!-- Row 3: P-Cores Isolation -->
                                        <Grid Margin="16,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" 
                                                    Background="{StaticResource BrushAccentSoft}" 
                                                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                                    Margin="0,0,14,0" VerticalAlignment="Center">
                                                <controls:AppIcon Data="{StaticResource Icon.Trend}" Size="17"
                                                                  Foreground="{StaticResource BrushAccentHover}"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{DynamicResource Set.Cores.Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                                <TextBlock Text="{DynamicResource Set.Cores.Desc}" Style="{StaticResource TextBody}" FontSize="11.5" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="2" Style="{StaticResource SwitchStyle}" IsChecked="{Binding IsolatePCores, Mode=TwoWay}" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Border Height="1" Background="{StaticResource BrushBorder}" Margin="66,0,16,0" Opacity="0.5"/>

                                        <!-- Row 4: Background Suppression -->
                                        <Grid Margin="16,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" 
                                                    Background="{StaticResource BrushAccentSoft}" 
                                                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                                    Margin="0,0,14,0" VerticalAlignment="Center">
                                                <controls:AppIcon Data="{StaticResource Icon.Activity}" Size="17"
                                                                  Foreground="{StaticResource BrushAccentHover}"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{DynamicResource Set.Bg.Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                                <TextBlock Text="{DynamicResource Set.Bg.Desc}" Style="{StaticResource TextBody}" FontSize="11.5" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="2" Style="{StaticResource SwitchStyle}" IsChecked="{Binding DeprioritizeBackground, Mode=TwoWay}" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Border Height="1" Background="{StaticResource BrushBorder}" Margin="66,0,16,0" Opacity="0.5"/>

                                        <!-- Row 5: Low-Latency Network (Zero-Ping) -->
                                        <Grid Margin="16,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" 
                                                    Background="{StaticResource BrushAccentSoft}" 
                                                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                                    Margin="0,0,14,0" VerticalAlignment="Center">
                                                <controls:AppIcon Data="{StaticResource Icon.Wifi}" Size="17"
                                                                  Foreground="{StaticResource BrushAccentHover}"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{DynamicResource Set.Network.Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                                <TextBlock Text="{DynamicResource Set.Network.Desc}" Style="{StaticResource TextBody}" FontSize="11.5" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="2" Style="{StaticResource SwitchStyle}" IsChecked="{Binding OptimizeNetwork, Mode=TwoWay}" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Border Height="1" Background="{StaticResource BrushBorder}" Margin="66,0,16,0" Opacity="0.5"/>

                                        <!-- Row 6: Disk I/O Streaming Acceleration -->
                                        <Grid Margin="16,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" 
                                                    Background="{StaticResource BrushAccentSoft}" 
                                                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                                    Margin="0,0,14,0" VerticalAlignment="Center">
                                                <controls:AppIcon Data="{StaticResource Icon.HardDrive}" Size="17"
                                                                  Foreground="{StaticResource BrushAccentHover}"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{DynamicResource Set.Io.Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                                <TextBlock Text="{DynamicResource Set.Io.Desc}" Style="{StaticResource TextBody}" FontSize="11.5" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="2" Style="{StaticResource SwitchStyle}" IsChecked="{Binding OptimizeIoPriority, Mode=TwoWay}" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Border Height="1" Background="{StaticResource BrushBorder}" Margin="66,0,16,0" Opacity="0.5"/>

                                        <!-- Row 7: Audio Latency & DPC Isolation -->
                                        <Grid Margin="16,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" 
                                                    Background="{StaticResource BrushAccentSoft}" 
                                                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                                    Margin="0,0,14,0" VerticalAlignment="Center">
                                                <controls:AppIcon Data="{StaticResource Icon.Volume}" Size="17"
