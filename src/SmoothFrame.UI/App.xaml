<Application x:Class="SmoothFrame.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SmoothFrame.UI.Controls"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- SmoothFrame Soft Violet Palette (Dark default, swapped dynamically via App.ApplyTheme) -->
            <SolidColorBrush x:Key="BrushBgWindow" Color="#13141D" />
            <SolidColorBrush x:Key="BrushBgSidebar" Color="#171823" />
            <SolidColorBrush x:Key="BrushBgTitleBar" Color="#151620" />
            <SolidColorBrush x:Key="BrushBgApp" Color="#13141D" />
            <SolidColorBrush x:Key="BrushBgSide" Color="#171823" />
            <SolidColorBrush x:Key="BrushBgCard" Color="#1C1E2B" />
            <SolidColorBrush x:Key="BrushCardBg" Color="#1C1E2B" />
            <SolidColorBrush x:Key="BrushBgCardHover" Color="#242638" />
            <SolidColorBrush x:Key="BrushCardHover" Color="#242638" />
            <SolidColorBrush x:Key="BrushBgInset" Color="#161722" />
            <SolidColorBrush x:Key="BrushBadgeSoft" Color="#23203C" />
            <SolidColorBrush x:Key="BrushOverlayScrim" Color="#9E0B0C14" />

            <SolidColorBrush x:Key="BrushBorder" Color="#282B3E" />
            <SolidColorBrush x:Key="BrushBorderSubtle" Color="#282B3E" />
            <SolidColorBrush x:Key="BrushBorderStrong" Color="#30334A" />
            <SolidColorBrush x:Key="BrushBorderCard" Color="#30334A" />
            <SolidColorBrush x:Key="BrushBorderGlow" Color="#4D427E" />
            <SolidColorBrush x:Key="BrushBorderAccent" Color="#6D5BD0" />

            <SolidColorBrush x:Key="BrushTextPrimary" Color="#ECEEF6" />
            <SolidColorBrush x:Key="BrushTextSecondary" Color="#AEB4C9" />
            <SolidColorBrush x:Key="BrushTextMuted" Color="#7B8199" />

            <SolidColorBrush x:Key="BrushAccent" Color="#7C6AE8" />
            <SolidColorBrush x:Key="BrushAccentHover" Color="#8D7DF2" />
            <SolidColorBrush x:Key="BrushAccentPressed" Color="#6957D4" />
            <SolidColorBrush x:Key="BrushAccentSoft" Color="#23203C" />
            <SolidColorBrush x:Key="BrushOnAccent" Color="#FFFFFF" />
            <SolidColorBrush x:Key="BrushVioletText" Color="#B8ACFF" />

            <SolidColorBrush x:Key="BrushSuccess" Color="#4CC38A" />
            <SolidColorBrush x:Key="BrushSuccessSoft" Color="#182E26" />
            <SolidColorBrush x:Key="BrushSuccessTint" Color="#182E26" />
            <SolidColorBrush x:Key="BrushSuccessBorder" Color="#285442" />

            <SolidColorBrush x:Key="BrushWarning" Color="#E0A854" />
            <SolidColorBrush x:Key="BrushWarningSoft" Color="#2E2416" />
            <SolidColorBrush x:Key="BrushWarningTint" Color="#2E2416" />
            <SolidColorBrush x:Key="BrushWarningBorder" Color="#5B4421" />

            <SolidColorBrush x:Key="BrushDanger" Color="#E26D7A" />
            <SolidColorBrush x:Key="BrushDangerHover" Color="#EB8590" />
            <SolidColorBrush x:Key="BrushDangerPressed" Color="#C85865" />
            <SolidColorBrush x:Key="BrushDangerSoft" Color="#301A20" />
            <SolidColorBrush x:Key="BrushDangerTint" Color="#301A20" />
            <SolidColorBrush x:Key="BrushDangerBorder" Color="#5E2B36" />

            <SolidColorBrush x:Key="BrushInfo" Color="#6EA8F5" />

            <SolidColorBrush x:Key="BrushScrollThumb" Color="#363A54" />
            <SolidColorBrush x:Key="BrushScrollThumbHover" Color="#5C5194" />
            <SolidColorBrush x:Key="BrushScrollTrack" Color="#151621" />

            <SolidColorBrush x:Key="BrushHeroRingOuter" Color="#167C6AE8" />
            <SolidColorBrush x:Key="BrushHeroRingMid" Color="#2E7C6AE8" />
            <SolidColorBrush x:Key="BrushHeroRingCore" Color="#24213B" />

            <LinearGradientBrush x:Key="BrushAccentGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#8978F0" Offset="0" />
                <GradientStop Color="#6D5BD0" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="BrushAccentGradientHover" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#998AF7" Offset="0" />
                <GradientStop Color="#7C6AE8" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="BrushHeroBg" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#201E33" Offset="0" />
                <GradientStop Color="#1A1C29" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="BrushHeroCardBg" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#201E33" Offset="0" />
                <GradientStop Color="#1A1C29" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="BrushMinecraftHeroBg" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#221F37" Offset="0" />
                <GradientStop Color="#1A1B29" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="BrushNavActiveBg" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#262344" Offset="0" />
                <GradientStop Color="#1F1D35" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="BrushDangerGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#E26D7A" Offset="0" />
                <GradientStop Color="#C94F5E" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="BrushDangerGradientHover" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#EC838E" Offset="0" />
                <GradientStop Color="#D65F6D" Offset="1" />
            </LinearGradientBrush>

            <!-- Clear, consistent typography -->
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>
            <Style x:Key="TextTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
                <Setter Property="FontSize" Value="25" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
            </Style>
            <Style x:Key="TextSection" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="TextBody" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="LineHeight" Value="19" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="TextCaption" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="TextValue" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- Consistent sleek ToolTip style -->
            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="{DynamicResource BrushCardBg}" />
                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="UseLayoutRounding" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7" Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="controls:AppIcon">
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="controls:AppIcon">
                            <Viewbox Width="{TemplateBinding Size}" Height="{TemplateBinding Size}" Stretch="Uniform">
                                <Path x:Name="Glyph"
                                      Data="{TemplateBinding Data}"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="{TemplateBinding StrokeThickness}"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Fill="Transparent" />
                            </Viewbox>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Filled" Value="True">
                                    <Setter TargetName="Glyph" Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <Setter TargetName="Glyph" Property="StrokeThickness" Value="0" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Surfaces: soft, crisp, no heavy shadows softening text or slowing scroll -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource BrushCardBg}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>
            <Style x:Key="HeroCard" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource BrushHeroBg}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderGlow}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>
            <Style x:Key="CardInset" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource BrushBgInset}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>

            <!-- Cyber Glow Master Action Button (Video-inspired dark pill container, laser beam & dynamic underglow) -->
            <Style x:Key="HeroActionButton" TargetType="Button">
                <Setter Property="Foreground" Value="#FFFFFF" />
                <Setter Property="Padding" Value="24,14" />
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid SnapsToDevicePixels="True" UseLayoutRounding="True" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="ButtonScale" ScaleX="1.0" ScaleY="1.0" />
                                </Grid.RenderTransform>

                                <!-- Dynamic Moving Underglow Spotlight - Violet (Idle) -->
                                <Border x:Name="HeroGlowViolet" CornerRadius="18" Margin="-16,-10,-16,-14" IsHitTestVisible="False" Opacity="0.85">
                                    <Border.Background>
                                        <LinearGradientBrush x:Name="HeroGlowVioletBrush" StartPoint="-0.6,1" EndPoint="0.0,1">
                                            <GradientStop Color="#00000000" Offset="0" />
                                            <GradientStop Color="#337C6AE8" Offset="0.25" />
                                            <GradientStop Color="#CC7C6AE8" Offset="0.5" />
                                            <GradientStop Color="#337C6AE8" Offset="0.75" />
                                            <GradientStop Color="#00000000" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <!-- Dynamic Moving Underglow Spotlight - Neon Red (Active Optimizing) -->
                                <Border x:Name="HeroGlowRed" CornerRadius="18" Margin="-16,-10,-16,-14" IsHitTestVisible="False" Opacity="0" Visibility="Collapsed">
                                    <Border.Background>
                                        <LinearGradientBrush x:Name="HeroGlowRedBrush" StartPoint="-0.6,1" EndPoint="0.0,1">
                                            <GradientStop Color="#00000000" Offset="0" />
                                            <GradientStop Color="#44EF4444" Offset="0.25" />
                                            <GradientStop Color="#DDEF4444" Offset="0.5" />
                                            <GradientStop Color="#44EF4444" Offset="0.75" />
                                            <GradientStop Color="#00000000" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <!-- Base Glass Border Ring -->
                                <Border x:Name="BorderBase" CornerRadius="14" Margin="-1.5" BorderThickness="1.5"
                                        BorderBrush="{DynamicResource BrushBorderAccent}" Opacity="0.45" IsHitTestVisible="False" />

                                <!-- Sharp Laser Beam traveling along bottom contour - Violet (Idle) -->
                                <Border x:Name="HeroBeamViolet" CornerRadius="14" Margin="-1.5" BorderThickness="1.8" IsHitTestVisible="False">
                                    <Border.BorderBrush>
                                        <LinearGradientBrush x:Name="HeroBeamVioletBrush" StartPoint="-0.6,1" EndPoint="0.0,1">
                                            <GradientStop Color="#00000000" Offset="0" />
                                            <GradientStop Color="#887C6AE8" Offset="0.25" />
                                            <GradientStop Color="#FFFFFFFF" Offset="0.5" />
                                            <GradientStop Color="#887C6AE8" Offset="0.75" />
                                            <GradientStop Color="#00000000" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.BorderBrush>
                                </Border>

                                <!-- Sharp Laser Beam traveling along bottom contour - Neon Red (Active Optimizing) -->
                                <Border x:Name="HeroBeamRed" CornerRadius="14" Margin="-1.5" BorderThickness="1.8" IsHitTestVisible="False" Visibility="Collapsed">
                                    <Border.BorderBrush>
                                        <LinearGradientBrush x:Name="HeroBeamRedBrush" StartPoint="-0.6,1" EndPoint="0.0,1">
                                            <GradientStop Color="#00000000" Offset="0" />
                                            <GradientStop Color="#99EF4444" Offset="0.25" />
                                            <GradientStop Color="#FFFFFFFF" Offset="0.5" />
                                            <GradientStop Color="#99EF4444" Offset="0.75" />
                                            <GradientStop Color="#00000000" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.BorderBrush>
                                </Border>

                                <!-- Main Button Body (Dark sleek pill container matching video reference) -->
                                <Border x:Name="ButtonSurface" CornerRadius="13" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Color="#231F38" Offset="0" />
                                            <GradientStop Color="#141122" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      RecognizesAccessKey="True" />
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <!-- Continuous Laser Beam Sweep Animation -->
                                <Trigger Property="IsEnabled" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard x:Name="HeroLaserBeamStoryboard">
                                            <Storyboard RepeatBehavior="Forever">
                                                <!-- Violet Beam & Underglow -->
                                                <PointAnimation Storyboard.TargetName="HeroBeamVioletBrush"
                                                                Storyboard.TargetProperty="StartPoint"
                                                                From="-0.6,1" To="1.2,1" Duration="0:0:2.0" AutoReverse="True">
                                                    <PointAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></PointAnimation.EasingFunction>
                                                </PointAnimation>
                                                <PointAnimation Storyboard.TargetName="HeroBeamVioletBrush"
                                                                Storyboard.TargetProperty="EndPoint"
                                                                From="0.0,1" To="1.8,1" Duration="0:0:2.0" AutoReverse="True">
                                                    <PointAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></PointAnimation.EasingFunction>
                                                </PointAnimation>
                                                <PointAnimation Storyboard.TargetName="HeroGlowVioletBrush"
                                                                Storyboard.TargetProperty="StartPoint"
                                                                From="-0.6,1" To="1.2,1" Duration="0:0:2.0" AutoReverse="True">
                                                    <PointAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></PointAnimation.EasingFunction>
                                                </PointAnimation>
                                                <PointAnimation Storyboard.TargetName="HeroGlowVioletBrush"
                                                                Storyboard.TargetProperty="EndPoint"
                                                                From="0.0,1" To="1.8,1" Duration="0:0:2.0" AutoReverse="True">
                                                    <PointAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></PointAnimation.EasingFunction>
                                                </PointAnimation>

                                                <!-- Red Beam & Underglow -->
                                                <PointAnimation Storyboard.TargetName="HeroBeamRedBrush"
                                                                Storyboard.TargetProperty="StartPoint"
                                                                From="-0.6,1" To="1.2,1" Duration="0:0:1.6" AutoReverse="True">
                                                    <PointAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></PointAnimation.EasingFunction>
                                                </PointAnimation>
                                                <PointAnimation Storyboard.TargetName="HeroBeamRedBrush"
                                                                Storyboard.TargetProperty="EndPoint"
                                                                From="0.0,1" To="1.8,1" Duration="0:0:1.6" AutoReverse="True">
                                                    <PointAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></PointAnimation.EasingFunction>
                                                </PointAnimation>
                                                <PointAnimation Storyboard.TargetName="HeroGlowRedBrush"
                                                                Storyboard.TargetProperty="StartPoint"
                                                                From="-0.6,1" To="1.2,1" Duration="0:0:1.6" AutoReverse="True">
                                                    <PointAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></PointAnimation.EasingFunction>
                                                </PointAnimation>
                                                <PointAnimation Storyboard.TargetName="HeroGlowRedBrush"
                                                                Storyboard.TargetProperty="EndPoint"
                                                                From="0.0,1" To="1.8,1" Duration="0:0:1.6" AutoReverse="True">
                                                    <PointAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></PointAnimation.EasingFunction>
                                                </PointAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonSurface" Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="#2F294C" Offset="0" />
                                                <GradientStop Color="#1A172C" Offset="1" />
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX"
                                                                 To="1.03" Duration="0:0:0.14">
                                                    <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY"
                                                                 To="1.03" Duration="0:0:0.14">
                                                    <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX"
                                                                 To="1.0" Duration="0:0:0.14">
                                                    <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY"
                                                                 To="1.0" Duration="0:0:0.14">
                                                    <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.88" />
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX"
                                                                 To="0.97" Duration="0:0:0.08" />
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY"
                                                                 To="0.97" Duration="0:0:0.08" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                </Trigger>
                                <!-- When Optimizing is ACTIVE: switch pill & beam to fiery dark crimson -->
                                <DataTrigger Binding="{Binding IsOptimizing}" Value="True">
                                    <Setter TargetName="ButtonSurface" Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="#3D1720" Offset="0" />
                                                <GradientStop Color="#1F0B10" Offset="1" />
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="BorderBase" Property="BorderBrush" Value="#66EF4444" />
                                    <Setter TargetName="HeroGlowViolet" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="HeroBeamViolet" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="HeroGlowRed" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="HeroGlowRed" Property="Opacity" Value="0.9" />
                                    <Setter TargetName="HeroBeamRed" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="HeroBeamRed" Property="Opacity" Value="1.0" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsOptimizing}" Value="True" />
                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="ButtonSurface" Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="#4D1D28" Offset="0" />
                                                <GradientStop Color="#290E15" Offset="1" />
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                </MultiDataTrigger>
                                <!-- When Minecraft Optimizing is ACTIVE: switch pill & beam to fiery dark crimson -->
                                <DataTrigger Binding="{Binding IsMinecraftOptimizing}" Value="True">
                                    <Setter TargetName="ButtonSurface" Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="#3D1720" Offset="0" />
                                                <GradientStop Color="#1F0B10" Offset="1" />
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="BorderBase" Property="BorderBrush" Value="#66EF4444" />
                                    <Setter TargetName="HeroGlowViolet" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="HeroBeamViolet" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="HeroGlowRed" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="HeroGlowRed" Property="Opacity" Value="0.9" />
                                    <Setter TargetName="HeroBeamRed" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="HeroBeamRed" Property="Opacity" Value="1.0" />
                                </DataTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.45" />
                                    <Setter TargetName="HeroGlowViolet" Property="Opacity" Value="0" />
                                    <Setter TargetName="HeroGlowRed" Property="Opacity" Value="0" />
                                    <Setter TargetName="HeroBeamViolet" Property="Opacity" Value="0" />
                                    <Setter TargetName="HeroBeamRed" Property="Opacity" Value="0" />
                                    <Trigger.EnterActions>
                                        <StopStoryboard BeginStoryboardName="HeroLaserBeamStoryboard" />
                                    </Trigger.EnterActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource BrushOnAccent}" />
                <Setter Property="Background" Value="{DynamicResource BrushAccentGradient}" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
