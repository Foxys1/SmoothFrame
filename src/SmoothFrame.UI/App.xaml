<Application x:Class="SmoothFrame.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SmoothFrame.UI.Controls"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Icons.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ================= Palette: Obsidian & Neon Violet (Minimalist Cyber) ================= -->
            <Color x:Key="ColorBgApp">#08080C</Color>
            <Color x:Key="ColorBgSide">#0B0B10</Color>
            <Color x:Key="ColorBgCard">#0F0F16</Color>
            <Color x:Key="ColorBgCardHover">#161622</Color>
            <Color x:Key="ColorBgInset">#0A0A10</Color>
            <Color x:Key="ColorBorder">#1A1A28</Color>
            <Color x:Key="ColorBorderStrong">#27263C</Color>
            <Color x:Key="ColorBorderGlow">#8B5CF6</Color>
            <Color x:Key="ColorTextPrimary">#FFFFFF</Color>
            <Color x:Key="ColorTextSecondary">#94A3B8</Color>
            <Color x:Key="ColorTextMuted">#64748B</Color>
            <Color x:Key="ColorAccent">#8B5CF6</Color>
            <Color x:Key="ColorAccentHover">#A78BFA</Color>
            <Color x:Key="ColorAccentPressed">#7C3AED</Color>
            <Color x:Key="ColorAccentSoft">#22163E</Color>
            <Color x:Key="ColorOnAccent">#FFFFFF</Color>
            <Color x:Key="ColorSuccess">#10B981</Color>
            <Color x:Key="ColorWarning">#F59E0B</Color>
            <Color x:Key="ColorDanger">#EF4444</Color>
            <Color x:Key="ColorVioletText">#C4B5FD</Color>

            <SolidColorBrush x:Key="BrushBgApp" Color="{StaticResource ColorBgApp}"/>
            <SolidColorBrush x:Key="BrushBgSide" Color="{StaticResource ColorBgSide}"/>
            <SolidColorBrush x:Key="BrushBgCard" Color="{StaticResource ColorBgCard}"/>
            <SolidColorBrush x:Key="BrushBgCardHover" Color="{StaticResource ColorBgCardHover}"/>
            <SolidColorBrush x:Key="BrushBgInset" Color="{StaticResource ColorBgInset}"/>
            <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}"/>
            <SolidColorBrush x:Key="BrushBorderStrong" Color="{StaticResource ColorBorderStrong}"/>
            <SolidColorBrush x:Key="BrushBorderGlow" Color="{StaticResource ColorBorderGlow}"/>
            <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}"/>
            <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}"/>
            <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}"/>
            <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}"/>
            <SolidColorBrush x:Key="BrushAccentHover" Color="{StaticResource ColorAccentHover}"/>
            <SolidColorBrush x:Key="BrushAccentPressed" Color="{StaticResource ColorAccentPressed}"/>
            <SolidColorBrush x:Key="BrushAccentSoft" Color="{StaticResource ColorAccentSoft}"/>
            <SolidColorBrush x:Key="BrushOnAccent" Color="{StaticResource ColorOnAccent}"/>
            <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}"/>
            <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}"/>
            <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}"/>
            <SolidColorBrush x:Key="BrushVioletText" Color="{StaticResource ColorVioletText}"/>

            <!-- Minimalist Electric Violet Gradients -->
            <LinearGradientBrush x:Key="BrushAccentGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#A855F7" Offset="0"/>
                <GradientStop Color="#8B5CF6" Offset="0.5"/>
                <GradientStop Color="#7C3AED" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="BrushAccentGradientHover" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#C084FC" Offset="0"/>
                <GradientStop Color="#A855F7" Offset="0.5"/>
                <GradientStop Color="#8B5CF6" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="BrushHeroCardBg" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#181135" Offset="0"/>
                <GradientStop Color="#0F0F1A" Offset="0.6"/>
                <GradientStop Color="#090910" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="BrushMinecraftHeroBg" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1C123D" Offset="0"/>
                <GradientStop Color="#111022" Offset="0.6"/>
                <GradientStop Color="#090910" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="BrushBorderGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#8B5CF6" Offset="0"/>
                <GradientStop Color="#581C87" Offset="0.45"/>
                <GradientStop Color="#1A1A28" Offset="1"/>
            </LinearGradientBrush>

            <!-- Minimalist hairline highlight -->
            <LinearGradientBrush x:Key="BrushTopHighlightBorder" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#2A2844" Offset="0"/>
                <GradientStop Color="#161524" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="BrushNavActiveBg" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#241744" Offset="0"/>
                <GradientStop Color="#110F20" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="BrushDangerGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FB7185" Offset="0"/>
                <GradientStop Color="#F43F5E" Offset="0.5"/>
                <GradientStop Color="#E11D48" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="BrushDangerGradientHover" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FDA4AF" Offset="0"/>
                <GradientStop Color="#FB7185" Offset="1"/>
            </LinearGradientBrush>

            <!-- ================= Base typography: Crystal Clear Segoe UI ================= -->
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
                <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            </Style>

            <Style x:Key="TextTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            </Style>

            <Style x:Key="TextSection" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            </Style>

            <Style x:Key="TextBody" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="LineHeight" Value="19"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            </Style>

            <Style x:Key="TextCaption" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            </Style>

            <Style x:Key="TextValue" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="FontSize" Value="19"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            </Style>

            <!-- ================= AppIcon (fluent glyph) ================= -->
            <Style TargetType="controls:AppIcon">
                <Setter Property="IsHitTestVisible" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="controls:AppIcon">
                            <Viewbox Width="{TemplateBinding Size}" Height="{TemplateBinding Size}">
                                <Path x:Name="Glyph"
                                      Data="{TemplateBinding Data}"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="{TemplateBinding StrokeThickness}"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Fill="Transparent"/>
                            </Viewbox>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Filled" Value="True">
                                    <Setter TargetName="Glyph" Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    <Setter TargetName="Glyph" Property="StrokeThickness" Value="0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ================= Bento Surfaces ================= -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource BrushBgCard}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrushTopHighlightBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="2" Opacity="0.35"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="HeroCard" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource BrushHeroCardBg}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrushBorderGlow}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#8B5CF6" BlurRadius="24" ShadowDepth="2" Opacity="0.3"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CardInset" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource BrushBgInset}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>

            <!-- ================= Buttons ================= -->
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource BrushAccentGradient}"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="FontSize" Value="13.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="20,11"/>
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect Color="#8B5CF6" BlurRadius="16" ShadowDepth="2" Opacity="0.5"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushAccentGradientHover}"/>
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.025" Duration="0:0:0.12"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.025" Duration="0:0:0.12"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.12"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.12"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushAccentPressed}"/>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource BrushBgCard}"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="14,9"/>
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{StaticResource BrushBorderStrong}"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushBgCardHover}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.02" Duration="0:0:0.12"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.02" Duration="0:0:0.12"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.12"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.12"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushBgInset}"/>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TitleBarButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
                <Setter Property="Width" Value="40"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Margin" Value="2,0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushBgCardHover}"/>
                                    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushBgInset}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TitleBarCloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="7" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushDanger}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#DC2626"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ================= Side navigation ================= -->
            <Style x:Key="SideNavItem" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
                <Setter Property="FontSize" Value="13.5"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="10"
                                    Margin="8,3" Padding="14,10" SnapsToDevicePixels="True"
                                    BorderThickness="1" BorderBrush="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Left active neon pill with glow and scale/fade animation -->
                                    <Border x:Name="ActivePill" Grid.Column="0" Width="4" Height="18" CornerRadius="2"
                                            Background="{StaticResource BrushAccentHover}" Margin="0,0,12,0"
                                            Opacity="0" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleY="0.2"/>
                                        </Border.RenderTransform>
                                        <Border.Effect>
                                            <DropShadowEffect Color="#8B5CF6" BlurRadius="10" ShadowDepth="0" Opacity="0.85"/>
                                        </Border.Effect>
                                    </Border>
                                    <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushBgCardHover}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushBorderStrong}"/>
                                    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushNavActiveBg}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushBorderGlow}"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ActivePill" Storyboard.TargetProperty="Opacity"
                                                                 To="1.0" Duration="0:0:0.2">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="ActivePill" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                 To="1.0" Duration="0:0:0.22">
                                                    <DoubleAnimation.EasingFunction>
                                                        <BackEase EasingMode="EaseOut" Amplitude="0.2"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ActivePill" Storyboard.TargetProperty="Opacity"
                                                                 To="0.0" Duration="0:0:0.12"/>
                                                <DoubleAnimation Storyboard.TargetName="ActivePill" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                 To="0.2" Duration="0:0:0.12"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ================= Toggle switch (animated) ================= -->
            <Style x:Key="SwitchStyle" TargetType="CheckBox">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid Background="Transparent">
                                <Border x:Name="Track" Width="44" Height="24" CornerRadius="12"
                                        BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border.Background>
                                        <SolidColorBrush Color="{StaticResource ColorBgInset}"/>
                                    </Border.Background>
                                    <Border.BorderBrush>
                                        <SolidColorBrush Color="{StaticResource ColorBorderStrong}"/>
                                    </Border.BorderBrush>
                                    <Ellipse x:Name="Thumb" Width="14" Height="14"
                                             HorizontalAlignment="Left" Margin="4,0,0,0">
                                        <Ellipse.Fill>
                                            <SolidColorBrush Color="{StaticResource ColorTextMuted}"/>
                                        </Ellipse.Fill>
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform x:Name="ThumbShift" X="0"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ThumbShift" Storyboard.TargetProperty="X"
                                                                 To="20" Duration="0:0:0.16">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="{StaticResource ColorAccent}" Duration="0:0:0.16"/>
                                                <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                To="{StaticResource ColorAccent}" Duration="0:0:0.16"/>
                                                <ColorAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(Ellipse.Fill).(SolidColorBrush.Color)"
                                                                To="{StaticResource ColorOnAccent}" Duration="0:0:0.16"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ThumbShift" Storyboard.TargetProperty="X"
                                                                 To="0" Duration="0:0:0.16">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="{StaticResource ColorBgInset}" Duration="0:0:0.16"/>
                                                <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                To="{StaticResource ColorBorderStrong}" Duration="0:0:0.16"/>
                                                <ColorAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(Ellipse.Fill).(SolidColorBrush.Color)"
                                                                To="{StaticResource ColorTextMuted}" Duration="0:0:0.16"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ================= Dark Modern RadioButton ================= -->
            <Style x:Key="DarkRadioButton" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="OuterCircle" Grid.Column="0" Width="18" Height="18" CornerRadius="9"
                                        Background="{StaticResource BrushBgInset}" BorderBrush="{StaticResource BrushBorderStrong}"
                                        BorderThickness="1.5" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <Ellipse x:Name="InnerDot" Width="8" Height="8" Fill="{StaticResource BrushAccentHover}"
                                             Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="OuterCircle" Property="BorderBrush" Value="{StaticResource BrushAccentHover}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="OuterCircle" Property="BorderBrush" Value="{StaticResource BrushAccentHover}"/>
                                    <Setter TargetName="OuterCircle" Property="Background" Value="{StaticResource BrushAccentSoft}"/>
                                    <Setter TargetName="InnerDot" Property="Visibility" Value="Visible"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ================= Dark Modern Slider ================= -->
            <Style x:Key="SliderThumbStyle" TargetType="Thumb">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border Width="18" Height="18" CornerRadius="9"
                                    Background="#FFFFFF"
                                    BorderBrush="{StaticResource BrushAccentHover}"
                                    BorderThickness="2">
                                <Border.Effect>
                                    <DropShadowEffect Color="#8B5CF6" BlurRadius="8" ShadowDepth="0" Opacity="0.7"/>
                                </Border.Effect>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DarkSlider" TargetType="Slider">
                <Setter Property="Height" Value="28"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid VerticalAlignment="Center">
                                <Border Height="6" CornerRadius="3"
                                        Background="{StaticResource BrushBgInset}"
                                        BorderBrush="{StaticResource BrushBorderStrong}"
                                        BorderThickness="1"/>
                                <Track x:Name="PART_Track">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource SliderThumbStyle}"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ================= Scrollbars (dark, thin) ================= -->
            <Style x:Key="DarkScrollBar" TargetType="ScrollBar">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Width" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="ThumbBd" CornerRadius="4" Margin="1"
                                                            Background="{StaticResource BrushBorderStrong}"/>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ThumbBd" Property="Background" Value="{StaticResource BrushAccentHover}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DarkScrollViewer" TargetType="ScrollViewer">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollViewer">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ScrollContentPresenter Grid.Column="0" Margin="{TemplateBinding Padding}"/>
                                <ScrollBar Grid.Column="1" Style="{StaticResource DarkScrollBar}"
                                           Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                           Maximum="{Binding ScrollableHeight, RelativeSource={RelativeSource TemplatedParent}}"
                                           ViewportSize="{Binding ViewportHeight, RelativeSource={RelativeSource TemplatedParent}}"
                                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ================= ComboBox (dark) ================= -->
            <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="6" Margin="4,1">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushBgCardHover}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushAccentSoft}"/>
                                    <Setter Property="Foreground" Value="{StaticResource BrushAccentHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DarkComboBox" TargetType="ComboBox">
                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItem}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Border x:Name="Bd" Background="{StaticResource BrushBgInset}"
                                        BorderBrush="{StaticResource BrushBorderStrong}" BorderThickness="1"
                                        CornerRadius="8" MinHeight="36">
                                    <Grid Margin="12,0,10,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter Grid.Column="0" VerticalAlignment="Center"
                                                          Content="{TemplateBinding SelectionBoxItem}"
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                                        <controls:AppIcon Grid.Column="1" Data="{StaticResource Icon.ChevronDown}"
                                                          Size="12" Foreground="{StaticResource BrushTextSecondary}"/>
                                    </Grid>
                                </Border>
                                <ToggleButton x:Name="PART_ToggleButton" Background="Transparent" BorderThickness="0"
                                              Focusable="False" ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Popup x:Name="PART_Popup" Placement="Bottom"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True" PopupAnimation="Fade">
                                    <Border Background="{StaticResource BrushBgCard}"
                                            BorderBrush="{StaticResource BrushBorderStrong}" BorderThickness="1"
                                            CornerRadius="9" MinWidth="{TemplateBinding ActualWidth}"
                                            Margin="0,4,0,0" Padding="2,4">
                                        <ScrollViewer MaxHeight="240" Style="{StaticResource DarkScrollViewer}">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                </Trigger>
                                <Trigger Property="IsDropDownOpen" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
