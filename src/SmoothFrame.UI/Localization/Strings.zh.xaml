    <sys:String x:Key="VM.Sub.Idle">点击"启用"运行优化配置</sys:String>
    <sys:String x:Key="VM.Timer.ActiveSuffix">毫秒（0.5 ms 高精度）</sys:String>
    <sys:String x:Key="VM.Timer.StdSuffix">毫秒（Windows 默认）</sys:String>
    <sys:String x:Key="VM.Power.Active">高性能</sys:String>
    <sys:String x:Key="VM.Power.Std">平衡 / 标准</sys:String>
    <sys:String x:Key="VM.Prio.Active">High Priority Class</sys:String>
