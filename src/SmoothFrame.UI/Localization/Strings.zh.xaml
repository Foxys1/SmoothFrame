    <sys:String x:Key="VM.Msg.NoGame">请从列表中选择游戏，或手动添加一个。</sys:String>
    <sys:String x:Key="VM.Dialog.ExeTitle">选择游戏可执行文件 (.exe)</sys:String>
    <sys:String x:Key="VM.Dialog.ExeFilter">可执行文件 (*.exe)|*.exe|所有文件 (*.*)|*.*</sys:String>
    <sys:String x:Key="VM.Msg.AddError">添加时出错：{0}</sys:String>
    <sys:String x:Key="VM.Msg.ErrorTitle">错误</sys:String>
    <sys:String x:Key="VM.Msg.RemoveConfirm">从游戏列表中移除"{0}"？</sys:String>
    <sys:String x:Key="VM.Msg.RemoveTitle">确认</sys:String>
