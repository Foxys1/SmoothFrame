    <sys:String x:Key="Prot.Title">Protection &amp; Security</sys:String>
    <sys:String x:Key="Prot.Subtitle">Hardware guarantees for system integrity and account safety</sys:String>
    <sys:String x:Key="Prot.Badge">100% ANTI-CHEAT SAFE</sys:String>
    <sys:String x:Key="Prot.Zero.Title">Zero-Injection Principle (0% Ban Risk)</sys:String>
    <sys:String x:Key="Prot.Zero.Desc">Absolute zero interference with game memory and executable binaries</sys:String>
    <sys:String x:Key="Prot.Zero.P1">0% injections: does not inject DLLs into active game process memory.</sys:String>
    <sys:String x:Key="Prot.Zero.P2">No DirectX or Vulkan hooks: rendering pipelines and shaders remain untouched.</sys:String>
    <sys:String x:Key="Prot.Zero.P3">Official Win32 APIs: optimizations use only native OS scheduler interfaces.</sys:String>
    <sys:String x:Key="Prot.Rev.Title">Strict Reversibility</sys:String>
    <sys:String x:Key="Prot.Rev.Desc">Instant restoration of all Windows settings to their exact prior state</sys:String>
    <sys:String x:Key="Prot.Rev.P1">System snapshot: timer resolutions and power plans are captured before optimization.</sys:String>
    <sys:String x:Key="Prot.Rev.P2">1-click rollback: closing the app or disabling boost immediately reverts all values.</sys:String>
    <sys:String x:Key="Prot.Rev.P3">Clean footprint: leaves zero background services, lingering daemons, or registry bloat.</sys:String>
    <sys:String x:Key="Prot.Crash.Title">Crash Recovery Engine</sys:String>
    <sys:String x:Key="Prot.Crash.Desc">Guaranteed recovery even during unexpected PC restarts or power loss</sys:String>
    <sys:String x:Key="Prot.Crash.P1">Non-volatile log: recovery restore point is safely committed to physical storage.</sys:String>
    <sys:String x:Key="Prot.Crash.P2">Auto fault-detection: resets settings on next boot if a crash or BSOD occurs.</sys:String>
    <sys:String x:Key="Prot.Crash.P3">Zero OS risk: safeguards Windows system files and ensures rock-solid stability.</sys:String>
    <sys:String x:Key="Prot.Chips.Title">VERIFIED COMPATIBLE WITH ALL MAJOR ANTI-CHEAT SYSTEMS</sys:String>

