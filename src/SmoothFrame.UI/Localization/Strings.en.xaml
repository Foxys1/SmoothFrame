    <sys:String x:Key="Card.Prio.Label">PROCESS PRIORITY</sys:String>
    <sys:String x:Key="Card.Prio.Hint">Top priority for game threads</sys:String>
    <sys:String x:Key="Hero.ActiveBadge">ACTIVE</sys:String>
    <sys:String x:Key="Hero.Protect">Protection: 0% memory injection, fully anti-cheat compatible</sys:String>
