    <sys:String x:Key="Opt.Title">Optimierung</sys:String>
    <sys:String x:Key="Opt.Subtitle">Systembeschleunigung mit einem Klick, vollständig umkehrbar</sys:String>
    <sys:String x:Key="Card.Timer.Label">SYSTEMTIMER</sys:String>
