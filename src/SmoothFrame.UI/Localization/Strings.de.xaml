    <sys:String x:Key="Card.Prio.Label">PROZESSPRIORITÄT</sys:String>
    <sys:String x:Key="Card.Prio.Hint">Höchste Priorität für Spiel-Threads</sys:String>
    <sys:String x:Key="Hero.ActiveBadge">AKTIV</sys:String>
    <sys:String x:Key="Hero.Protect">Schutz: 0 % Speicher-Injection, vollständig Anti-Cheat-kompatibel</sys:String>
    <sys:String x:Key="Lib.Title">Spielebibliothek</sys:String>
    <sys:String x:Key="Lib.Empty">Keine Spiele gefunden — fügen Sie oben eines hinzu</sys:String>
    <sys:String x:Key="Btn.AddGame">Spiel hinzufügen (.exe)</sys:String>
    <sys:String x:Key="Btn.Refresh">Aktualisieren</sys:String>
    <sys:String x:Key="Btn.Activate">Optimierung aktivieren</sys:String>
