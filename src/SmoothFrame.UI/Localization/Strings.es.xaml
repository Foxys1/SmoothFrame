    <sys:String x:Key="Card.Power.Label">PLAN DE ENERGÍA</sys:String>
    <sys:String x:Key="Card.Power.Hint">Desactiva el aparcado de núcleos de la CPU</sys:String>
    <sys:String x:Key="Card.Prio.Label">PRIORIDAD DEL PROCESO</sys:String>
    <sys:String x:Key="Card.Prio.Hint">Prioridad máxima para los hilos del juego</sys:String>
    <sys:String x:Key="Hero.ActiveBadge">ACTIVO</sys:String>
    <sys:String x:Key="Hero.Protect">Protección: 0 % de inyección en memoria, compatible con antitrampas</sys:String>
    <sys:String x:Key="Lib.Title">Biblioteca de juegos</sys:String>
    <sys:String x:Key="Lib.Empty">No se encontraron juegos: añade uno con el botón de arriba</sys:String>
