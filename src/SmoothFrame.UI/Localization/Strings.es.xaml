    <sys:String x:Key="Opt.Title">Optimización</sys:String>
    <sys:String x:Key="Opt.Subtitle">Aceleración del sistema con un clic y totalmente reversible</sys:String>
    <sys:String x:Key="Card.Timer.Label">TEMPORIZADOR DEL SISTEMA</sys:String>
